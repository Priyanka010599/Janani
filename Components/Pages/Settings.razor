@page "/settings"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Janani — Settings</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1>⚙️ @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_banner != null)
    {
        <div class="sos-safety-note">
            <p>@_banner</p>
        </div>
    }

    <div class="sos-card">
        <h3>📅 @T("GoogleCalendarHeading")</h3>
        @if (_account == null)
        {
            <p class="sos-hint">@T("ConnectCalendarHint")</p>
            <a class="bloom-btn primary" href="/calendar/connect/google">@T("ConnectCalendarButton")</a>
        }
        else
        {
            <p class="sos-hint">@T("ConnectedOn") @_account.ConnectedAt.ToLocalTime().ToString("dd MMM yyyy")</p>

            @if (_account.LastSyncFailed)
            {
                <div class="sos-safety-note">
                    <p>⚠️ @T("SyncFailedWarning")</p>
                </div>
            }

            <label class="checkbox-field">
                <input type="checkbox" @bind="_account.SyncEnabled" @bind:after="SaveSyncEnabledAsync" />
                @T("SyncAutomatically")
            </label>

            <div class="form-actions">
                <a class="bloom-btn secondary small-btn" href="/calendar/disconnect/google">@T("Disconnect")</a>
            </div>
        }
    </div>

    <div class="sos-card">
        <h3>🔔 @T("NotificationsHeading")</h3>
        <p class="sos-hint">@T("NotificationsHint")</p>
        @if (_pushEnabled)
        {
            <p class="sos-hint">✅ @T("NotificationsOn")</p>
        }
        else
        {
            <button class="bloom-btn primary small-btn" @onclick="EnablePushAsync" disabled="@_enablingPush">
                @if (_enablingPush) { <span>@T("Enabling")</span> } else { <span>@T("EnableNotifications")</span> }
            </button>
        }
        @if (_pushError != null)
        {
            <p class="sos-hint">💗 @_pushError</p>
        }
    </div>

    <div class="sos-card">
        <h3>🩺 @T("DoctorAlertHeading")</h3>
        <p class="sos-hint">@T("DoctorAlertHint")</p>
    </div>

    <div class="sos-card">
        <h3>🔒 @T("PrivacyHeading")</h3>
        <p class="sos-hint">@T("PrivacyHint")</p>
        <button type="button" class="bloom-btn secondary small-btn" onclick="document.getElementById('privacy-dialog').showModal()">@T("PrivacyLinkBtn")</button>
    </div>

    <dialog id="privacy-dialog" class="privacy-dialog">
        <h1>🔒 Privacy Policy</h1>
        <PrivacyPolicyContent />
        <button type="button" class="bloom-btn secondary small-btn" onclick="document.getElementById('privacy-dialog').close()">@T("CloseBtn")</button>
    </dialog>

    <div class="sos-card">
        <h3>📟 @T("DevicePairingHeading")</h3>
        <p class="sos-hint">@T("DevicePairingHint")</p>
        @if (!string.IsNullOrEmpty(_devicePairingToken))
        {
            <p class="sos-hint" style="word-break:break-all;">@_devicePairingToken</p>
        }
        else
        {
            <p class="sos-hint">@T("DevicePairingNotSet")</p>
        }
        <button class="bloom-btn secondary small-btn" @onclick="GenerateDevicePairingTokenAsync">
            @(string.IsNullOrEmpty(_devicePairingToken) ? T("DevicePairingGenerateBtn") : T("DevicePairingRegenerateBtn"))
        </button>
    </div>
</div>

@code {
    private ConnectedCalendarAccount? _account;
    private string? _banner;
    private bool _pushEnabled;
    private bool _enablingPush;
    private string? _pushError;
    private string _language = "English";
    private string? _devicePairingToken;

    private record PushEnableResult(bool Ok, string? Reason);

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();
        _devicePairingToken = profile?.DevicePairingToken;

        var uri = new Uri(Nav.Uri);
        var query = !string.IsNullOrEmpty(uri.Query)
            ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            : null;
        var calendarParam = query != null && query.TryGetValue("calendar", out var v) ? v.ToString() : null;

        _banner = calendarParam switch
        {
            "connected" => T("BannerCalendarConnected"),
            "disconnected" => T("BannerCalendarDisconnected"),
            "error" => T("BannerCalendarError"),
            _ => null
        };

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        _account = await Db.ConnectedCalendarAccounts
            .FirstOrDefaultAsync(a => a.UserId == userId && a.Provider == "Google");
    }

    private async Task SaveSyncEnabledAsync() => await Db.SaveChangesAsync();

    private async Task GenerateDevicePairingTokenAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var token = Guid.NewGuid().ToString("N");
        await Db.UserProfiles.Where(p => p.UserId == userId)
            .ExecuteUpdateAsync(s => s.SetProperty(p => p.DevicePairingToken, token));
        _devicePairingToken = token;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Browser permission is the closest signal available for "already
        // enabled on this device" without round-tripping a device id —
        // good enough for this toggle's purpose (avoid a redundant prompt).
        var permission = await JS.InvokeAsync<string>("jananiPush.permission");
        _pushEnabled = permission == "granted";
        StateHasChanged();
    }

    private async Task EnablePushAsync()
    {
        _enablingPush = true;
        _pushError = null;
        StateHasChanged();

        var result = await JS.InvokeAsync<PushEnableResult>("jananiPush.enable");
        _pushEnabled = result.Ok;
        if (!result.Ok)
        {
            _pushError = result.Reason switch
            {
                "denied" => T("PushDenied"),
                "unsupported" => T("PushUnsupported"),
                _ => T("PushError")
            };
        }

        _enablingPush = false;
    }

