    private string _state = "";
    private string _area = "";
    private string _category = "";
    private string _govt = "";
    private int? _age;
    private int _births;
    private bool _expecting, _lactating, _infant;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();

        // Prefill only what the app already knows about her; everything else she states herself.
        _lactating = profile?.PostpartumDay != null;
        _expecting = (profile?.TracksPregnancy ?? false) && !_lactating;

        var userId = await CurrentUser.GetUserIdAsync();
        var infantIds = await CareAccess.GetAccessibleInfantIdsAsync(userId);
        var infants = await Db.InfantProfiles.AsNoTracking().Where(i => infantIds.Contains(i.Id)).ToListAsync();
        _infant = infants.Any(i => i.AgeInWeeks < 52);
    }

    private SchemeInput BuildInput() => new(
        string.IsNullOrEmpty(_state) ? null : _state,
        _area switch { "rural" => true, "urban" => false, _ => (bool?)null },
        _age,
        _expecting, _lactating, _infant,
        _births,
        ToBool(_category),
        ToBool(_govt));

    private static bool? ToBool(string v) => v switch { "yes" => true, "no" => false, _ => null };

    private static string StatusClass(MatchStatus s) => s switch
    {
        MatchStatus.Likely => "guardrail-ok",
        MatchStatus.Possible => "sev-warning",
        _ => "scheme-muted"
    };

