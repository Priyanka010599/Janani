@page "/schemes"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject UserProfileCache ProfileCache
@inject CareAccessService CareAccess
@rendermode InteractiveServer

<PageTitle>Janani — Government schemes</PageTitle>

@{
    // The verdicts are a pure function of the answers above them (SchemeMatcher: plain
    // code, no model). Recomputed every render, so changing an answer changes them at once.
    var matches = SchemeMatcher.Match(BuildInput())
        .OrderBy(m => m.Status)   // Likely, Possible, Unlikely
        .ToList();
}

<div class="bloom-container guardrail-wide">
    <div class="section-header">
        <h1><Icon Name="family"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    <p class="data-source-note">@T("PrivacyNote")</p>

    <div class="guardrail-steps">

        <div class="plan-card guardrail-step">
            <h3>@T("AboutYou")</h3>

            <div class="form-field">
                <label>@T("State")</label>
                <select @bind="_state">
                    <option value="">@T("Choose")</option>
                    @foreach (var s in States)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label>@T("Area")</label>
                <select @bind="_area">
                    <option value="">@T("NotSure")</option>
                    <option value="rural">@T("Rural")</option>
                    <option value="urban">@T("Urban")</option>
                </select>
            </div>
            <div class="form-field">
                <label>@T("Age")</label>
                <input type="number" @bind="_age" @bind:event="oninput" />
            </div>
            <div class="form-field">
                <label>@T("Children")</label>
                <select @bind="_births">
                    <option value="0">0</option>
                    <option value="1">1</option>
                    <option value="2">2 @T("OrMore")</option>
                </select>
            </div>
            <div class="form-field">
                <label>@T("Category")</label>
                <select @bind="_category">
                    <option value="">@T("NotSure")</option>
                    <option value="yes">@T("Yes")</option>
                    <option value="no">@T("No")</option>
                </select>
            </div>
            <div class="form-field">
                <label>@T("Govt")</label>
                <select @bind="_govt">
                    <option value="">@T("NotSure")</option>
                    <option value="yes">@T("Yes")</option>
                    <option value="no">@T("No")</option>
                </select>
            </div>
            <div class="form-field">
                <label class="scheme-check"><input type="checkbox" @bind="_expecting" /> @T("Expecting")</label>
                <label class="scheme-check"><input type="checkbox" @bind="_lactating" /> @T("Lactating")</label>
                <label class="scheme-check"><input type="checkbox" @bind="_infant" /> @T("Infant")</label>
            </div>
        </div>

        <div class="guardrail-results">
            @foreach (var m in matches)
            {
                <div class="plan-card scheme-card scheme-@m.Status.ToString().ToLowerInvariant()">
                    <div class="scheme-head">
                        <strong>@T("Name_" + m.Scheme)</strong>
                        <span class="guardrail-sev @StatusClass(m.Status)">@T("Status_" + m.Status)</span>
                    </div>
                    <p class="data-source-note">@T("Blurb_" + m.Scheme)</p>
                    @if (m.AmountRupees is { } amount)
                    {
                        <p class="scheme-amount">₹@amount.ToString("N0") @T("Amount_" + m.Scheme)</p>
                    }
                    <ul class="guardrail-concerns">
                        @foreach (var r in m.Reasons)
                        {
                            <li>@T("R_" + r)</li>
                        }
                    </ul>
                    @if (m.Status != MatchStatus.Unlikely)
                    {
                        <p class="scheme-next"><strong>@T("NextStep"):</strong> @T("Next_" + m.Scheme)</p>
                    }
                </div>
            }
        </div>

    </div>

    <p class="data-source-note guardrail-footer">@T("Footer") (@SchemeMatcher.AsOf)</p>
</div>

