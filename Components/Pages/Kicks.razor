@page "/kicks"
@using Janani.Data
@using Janani.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@rendermode InteractiveServer

<PageTitle>Janani — Baby Kicks</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="kicks"/> @T("Title")</h1>
        <p class="subtitle">
            @T("Subtitle")
        </p>
    </div>

    <div class="kick-card @(_kicks >= 10 ? "goal-reached" : "")">
        <div class="kick-count-display">
            <span class="kick-big" @key="_kicks">@_kicks</span>
            <span class="kick-label">@T("KicksThisSession")</span>
        </div>

        @if (_kicks >= 10)
        {
            <div class="celebration">@T("Celebration")</div>
        }

        <button class="kick-btn" @onclick="RecordKick">
            <span class="kick-emoji">🩷</span>
            <span>@T("TapForEachKick")</span>
        </button>

        @if (_kicks > 0)
        {
            <p class="kick-time">@string.Format(T("StartedFormat"), _sessionStart?.ToString("HH:mm"), ElapsedMinutes)</p>
        }

        <div class="kick-message">
            <p>@GetKickMessage()</p>
        </div>

        @if (_kicks > 0)
        {
            <div class="kick-actions">
                <button class="bloom-btn primary" @onclick="SaveSessionAsync">
                    @T("SaveSession")
                </button>
                <button class="bloom-btn secondary" @onclick="ResetSession">
                    @T("Reset")
                </button>
            </div>
        }
    </div>

    <div class="kick-guidance">
        <h3>@T("GuidanceTitle")</h3>
        <ul class="tips-list">
            <li>@T("Tip1")</li>
            <li>@T("Tip2")</li>
            <li>@T("Tip3")</li>
            <li>@T("Tip4")</li>
            <li>@T("Tip5")</li>
        </ul>
    </div>

    @if (_history.Any())
    {
        <div class="kick-history">
            <h3>@T("RecentSessions")</h3>
            @{ var sessionIndex = 0; }
            @foreach (var s in _history)
            {
                var sIdx = sessionIndex++;
                <div class="history-item" style="animation-delay: @(sIdx * 0.05)s">
                    <span>@s.Date.ToString("dd MMM")</span>
                    <span><strong>@s.KickCount</strong> @T("KicksWord")</span>
                    <span>@s.DurationMinutes @T("MinWord")</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private int _kicks;
    private DateTime? _sessionStart;
    private List<KickSession> _history = [];
    private string _language = "English";

    private int ElapsedMinutes =>
        _sessionStart.HasValue ? (int)(DateTime.Now - _sessionStart.Value).TotalMinutes : 0;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();

        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        _history = await Db.KickSessions.AsNoTracking()
            .Where(k => k.UserId == userId)
            .OrderByDescending(k => k.Date)
            .Take(5)
            .ToListAsync();
    }

    private void RecordKick()
    {
        _sessionStart ??= DateTime.Now;
        _kicks++;
    }

    private async Task SaveSessionAsync()
    {
        if (_kicks == 0 || !_sessionStart.HasValue) return;
        Db.KickSessions.Add(new KickSession
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Date = DateOnly.FromDateTime(DateTime.Today),
            KickCount = _kicks,
            DurationMinutes = ElapsedMinutes
        });
        await Db.SaveChangesAsync();
        await LoadHistoryAsync();
        ResetSession();
    }

    private void ResetSession()
    {
        _kicks = 0;
        _sessionStart = null;
    }

    private string GetKickMessage() => _kicks switch
    {
        0 => T("KickMsg0"),
        < 3 => T("KickMsg1"),
        < 6 => T("KickMsg2"),
