@page "/postpartum-checkin"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject UserProfileCache ProfileCache
@inject PostpartumCheckInService CheckInService
@rendermode InteractiveServer

<PageTitle>Janani — Postpartum Check-In</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1>💗 @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_postpartumDay == null)
    {
        <div class="empty-state">
            <p>@T("NotYetTitle")</p>
            <p>@T("NotYetHint")</p>
        </div>
    }
    else
    {
    @if (_activeAlert != null)
    {
        <div class="sos-safety-note">
            <p>@(_activeAlert.Severity == AlertSeverity.Critical ? "🚨" : "⚠️") @_activeAlert.Message</p>
            <a class="bloom-btn primary small-btn" href="/emergency">🆘 @T("SendSosBtn")</a>
            <button class="bloom-btn secondary small-btn" @onclick="AcknowledgeAlertAsync">@T("SeenThisBtn")</button>
        </div>
    }

    <div class="plan-card">
        <h3>@T("PainLabel")</h3>
        <div class="feeling-grid">
            @for (var pain = 0; pain <= 10; pain++)
            {
                var level = pain;
                <button type="button" class="feeling-btn @(_painLevel == level ? "selected" : "")" @onclick="() => _painLevel = level">@level</button>
            }
        </div>

        <h3>@T("BleedingLabel")</h3>
        <div class="feeling-grid">
            <button type="button" class="feeling-btn @(_bleeding == BleedingLevel.None ? "selected" : "")" @onclick="() => _bleeding = BleedingLevel.None">@T("BleedingNone")</button>
            <button type="button" class="feeling-btn @(_bleeding == BleedingLevel.Light ? "selected" : "")" @onclick="() => _bleeding = BleedingLevel.Light">@T("BleedingLight")</button>
            <button type="button" class="feeling-btn @(_bleeding == BleedingLevel.Moderate ? "selected" : "")" @onclick="() => _bleeding = BleedingLevel.Moderate">@T("BleedingModerate")</button>
            <button type="button" class="feeling-btn @(_bleeding == BleedingLevel.Heavy ? "selected" : "")" @onclick="() => _bleeding = BleedingLevel.Heavy">@T("BleedingHeavy")</button>
            <button type="button" class="feeling-btn @(_bleeding == BleedingLevel.SoakingPadHourly ? "selected" : "")" @onclick="() => _bleeding = BleedingLevel.SoakingPadHourly">@T("BleedingSoaking")</button>
        </div>

        <h3>@T("TempLabel")</h3>
        <input type="number" step="0.1" @bind="_temperature" placeholder="@T("TempPlaceholder")" />

        <h3>@_woundQuestion</h3>
        <div class="feeling-grid">
            <button type="button" class="feeling-btn @(_wound == WoundStatus.HealingWell ? "selected" : "")" @onclick="() => _wound = WoundStatus.HealingWell">@T("WoundHealingWell")</button>
            <button type="button" class="feeling-btn @(_wound == WoundStatus.MildRednessOrSwelling ? "selected" : "")" @onclick="() => _wound = WoundStatus.MildRednessOrSwelling">@T("WoundMild")</button>
            <button type="button" class="feeling-btn @(_wound == WoundStatus.SignificantConcern ? "selected" : "")" @onclick="() => _wound = WoundStatus.SignificantConcern">@T("WoundSignificant")</button>
        </div>

        <h3>@T("MoodLabel")</h3>
        <div class="mood-grid">
            @foreach (var mood in Enum.GetValues<MoodType>())
            {
                <button type="button" class="mood-btn @(_mood == mood ? "selected" : "")" @onclick="() => _mood = mood">
                    <span class="mood-emoji">@MoodEmoji(mood)</span>
                    <span class="mood-label">@MoodLabel(mood)</span>
                </button>
            }
        </div>

        <div class="form-actions">
            <button class="bloom-btn primary" @onclick="SubmitCheckInAsync" disabled="@_submitting">
                @(_submitting ? T("Submitting") : T("SubmitBtn"))
            </button>
            @if (_justSubmitted)
            {
                <span class="sos-hint">✅ @T("SubmittedToday")</span>
            }
        </div>
    </div>

    @if (_epdsDue)
    {
        <div class="plan-card">
            <h3>🧠 @T("EpdsTitle")</h3>
            @if (!EpdsContent.IsLanguageAvailable(_appLanguage))
            {
                <p class="sos-hint">@T("EpdsUnavailableInLanguage")</p>
            }
            else if (_epdsJustSubmitted)
            {
                <p class="sos-hint">✅ @T("EpdsSubmittedThanks")</p>
            }
            else if (!_epdsStarted)
            {
                <p>@T("EpdsIntro")</p>
                <p class="sos-hint">@T("EpdsAttribution")</p>
                <button class="bloom-btn secondary" @onclick="() => _epdsStarted = true">@T("EpdsStartBtn")</button>
            }
            else
            {
                @foreach (var item in EpdsContent.EnglishItems)
                {
                    <div class="form-field">
                        <label>@item.Number. @item.Statement</label>
                        <div class="feeling-grid">
                            @for (var i = 0; i < item.Options.Length; i++)
                            {
                                var optionIndex = i;
                                <button type="button"
                                        class="feeling-btn @(_epdsAnswers.GetValueOrDefault(item.Number, -1) == optionIndex ? "selected" : "")"
                                        @onclick="() => _epdsAnswers[item.Number] = optionIndex">
                                    @item.Options[optionIndex]
                                </button>
                            }
                        </div>
                    </div>
                }
                <button class="bloom-btn primary" @onclick="SubmitEpdsAsync" disabled="@(!AllEpdsAnswered() || _submittingEpds)">
                    @(_submittingEpds ? T("Submitting") : T("EpdsSubmitBtn"))
                </button>
            }
        </div>
    }
    }
</div>

@code {
    private int _userId;
    private AppLanguage _appLanguage = AppLanguage.English;
    private string _language = "English";
    private int? _postpartumDay;
    private DeliveryType? _deliveryType;
    private string _userName = "Mama";
    private string? _doctorName;
    private string? _doctorEmail;

    private int _painLevel;
    private BleedingLevel _bleeding = BleedingLevel.None;
    private decimal? _temperature;
    private WoundStatus _wound = WoundStatus.HealingWell;
    private MoodType _mood = MoodType.Peaceful;
    private string _woundQuestion = "";
    private bool _submitting;
    private bool _justSubmitted;
    private PostpartumAlert? _activeAlert;

    private bool _epdsDue;
    private int _epdsScheduledDay;
    private bool _epdsStarted;
    private bool _submittingEpds;
    private bool _epdsJustSubmitted;
    private readonly Dictionary<int, int> _epdsAnswers = [];

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetUserIdAsync();
        var profile = await ProfileCache.GetAsync();
        _appLanguage = profile?.Language ?? AppLanguage.English;
        _language = _appLanguage.ToString();
        _deliveryType = profile?.DeliveryType;
        _userName = string.IsNullOrWhiteSpace(profile?.Name) ? "Mama" : profile.Name;
        _doctorName = profile?.DoctorName;
        _doctorEmail = profile?.DoctorEmail;
        _woundQuestion = PostpartumCheckInQuestions.WoundQuestionFor(_deliveryType);

        _postpartumDay = profile?.PostpartumDay;
        if (_postpartumDay == null) return;

        _activeAlert = await Db.PostpartumAlerts.AsNoTracking()
            .Where(a => a.UserId == _userId && !a.Acknowledged)
            .OrderByDescending(a => a.TriggeredAt)
            .FirstOrDefaultAsync();

        var day = _postpartumDay.Value;
        var completedDays = await Db.EpdsScreenings.AsNoTracking()
            .Where(e => e.UserId == _userId)
            .Select(e => e.ScheduledDay)
            .ToListAsync();

        foreach (var milestone in new[] { 10, 42 })
        {
            if (day >= milestone && !completedDays.Contains(milestone))
            {
                _epdsDue = true;
                _epdsScheduledDay = milestone;
                break;
            }
        }
    }

    private bool AllEpdsAnswered() => EpdsContent.EnglishItems.All(i => _epdsAnswers.ContainsKey(i.Number));

    private async Task SubmitCheckInAsync()
    {
        _submitting = true;
        _justSubmitted = false;
        StateHasChanged();

        var checkIn = new Janani.Models.PostpartumCheckIn
        {
            UserId = _userId,
            PainLevel = _painLevel,
            Bleeding = _bleeding,
            TemperatureC = _temperature,
            Wound = _wound,
            Mood = _mood
        };

        await CheckInService.SubmitCheckInAsync(checkIn, _userName, _doctorName, _doctorEmail, _appLanguage);

        _activeAlert = await Db.PostpartumAlerts.AsNoTracking()
            .Where(a => a.UserId == _userId && !a.Acknowledged)
            .OrderByDescending(a => a.TriggeredAt)
            .FirstOrDefaultAsync();

        _submitting = false;
        _justSubmitted = true;
    }

    private async Task SubmitEpdsAsync()
    {
        if (!AllEpdsAnswered()) return;
        _submittingEpds = true;
        StateHasChanged();

        var screening = new EpdsScreening
        {
            UserId = _userId,
            ScheduledDay = _epdsScheduledDay,
            Item1 = ScoreFor(1), Item2 = ScoreFor(2), Item3 = ScoreFor(3), Item4 = ScoreFor(4), Item5 = ScoreFor(5),
            Item6 = ScoreFor(6), Item7 = ScoreFor(7), Item8 = ScoreFor(8), Item9 = ScoreFor(9), Item10 = ScoreFor(10)
        };

        await CheckInService.SubmitEpdsScreeningAsync(screening, _userName, _doctorName, _doctorEmail, _appLanguage);

        _activeAlert = await Db.PostpartumAlerts.AsNoTracking()
            .Where(a => a.UserId == _userId && !a.Acknowledged)
            .OrderByDescending(a => a.TriggeredAt)
            .FirstOrDefaultAsync();

        _submittingEpds = false;
        _epdsJustSubmitted = true;
        _epdsDue = false;

        int ScoreFor(int itemNumber)
        {
            var item = EpdsContent.EnglishItems.Single(i => i.Number == itemNumber);
            return EpdsContent.ScoreForSelection(item, _epdsAnswers[itemNumber]);
        }
    }

    private async Task AcknowledgeAlertAsync()
    {
        if (_activeAlert == null) return;
        var alert = await Db.PostpartumAlerts.FindAsync(_activeAlert.Id);
        if (alert != null)
        {
            alert.Acknowledged = true;
            await Db.SaveChangesAsync();
        }
        _activeAlert = null;
    }

    private static string MoodEmoji(MoodType mood) => mood switch
    {
        MoodType.Exhausted => "😴",
        MoodType.Anxious => "😟",
        MoodType.Nauseous => "🤢",
        MoodType.Emotional => "🥺",
        MoodType.Happy => "😊",
        MoodType.Energetic => "✨",
        MoodType.Overwhelmed => "😮‍💨",
        MoodType.Peaceful => "🌿",
        _ => ""
    };

    private string MoodLabel(MoodType mood) => mood switch
    {
        MoodType.Exhausted => T("MoodExhausted"),
        MoodType.Anxious => T("MoodAnxious"),
        MoodType.Nauseous => T("MoodNauseous"),
        MoodType.Emotional => T("MoodEmotional"),
        MoodType.Happy => T("MoodHappy"),
        MoodType.Energetic => T("MoodEnergetic"),
        MoodType.Overwhelmed => T("MoodOverwhelmed"),
        MoodType.Peaceful => T("MoodPeaceful"),
        _ => mood.ToString()
    };

