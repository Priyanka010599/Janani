@page "/appointments"
@using Janani.Models
@using Janani.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject ICalendarSyncService CalendarSync
@rendermode InteractiveServer

<PageTitle>Janani — Appointment Hub</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="appointments"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_adding)
    {
        <div class="appointment-form">
            <h3>@T("AddAppointmentHeading")</h3>

            <div class="form-field">
                <label>@T("KindLabel")</label>
                <input @bind="_newTitle" placeholder="@T("KindPlaceholder")" />
            </div>

            <div class="form-row">
                <div class="form-field">
                    <label>@T("DateTimeLabel")</label>
                    <input type="datetime-local" @bind="_newDate" />
                </div>
                <div class="form-field">
                    <label>@T("DoctorLabel")</label>
                    <input @bind="_newDoctor" placeholder="@T("DoctorPlaceholder")" />
                </div>
            </div>

            <div class="form-field">
                <label>@T("LocationLabel")</label>
                <input @bind="_newLocation" placeholder="@T("LocationPlaceholder")" />
            </div>

            <div class="form-field">
                <label>@T("QuestionsLabel")</label>
                <textarea @bind="_newQuestions"
                          placeholder="@T("QuestionsPlaceholder")"
                          rows="4"></textarea>
            </div>

            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveAppointmentAsync"
                        disabled="@string.IsNullOrWhiteSpace(_newTitle)">
                    @T("SaveAppointmentButton")
                </button>
                <button class="bloom-btn secondary" @onclick="() => _adding = false">@T("Cancel")</button>
            </div>
        </div>
    }
    else
    {
        <button class="bloom-btn primary new-entry-btn" @onclick="() => _adding = true">
            + @T("AddAppointmentButton")
        </button>
    }

    @if (_noteTarget != null)
    {
        <div class="appointment-form">
            <h3>@T("NotesHeading")</h3>
            <p class="visit-title">@_noteTarget.Title — @_noteTarget.AppointmentDate.ToString("dd MMM yyyy")</p>
            <textarea @bind="_noteText"
                      placeholder="@T("NotesPlaceholder")"
                      rows="5"></textarea>
            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveNoteAsync">@T("SaveNotesButton")</button>
                <button class="bloom-btn secondary" @onclick="() => _noteTarget = null">@T("Cancel")</button>
            </div>
        </div>
    }

    <div class="appointments-list">
        @if (!_upcoming.Any() && !_past.Any())
        {
            <div class="empty-state">
                <p>@T("EmptyStateTitle")</p>
                <p>@T("EmptyStateHint")</p>
            </div>
        }

        @if (_upcoming.Any())
        {
            <h3 class="list-section-title">@T("UpcomingHeading")</h3>
            @foreach (var appt in _upcoming)
            {
                <div class="appointment-card upcoming" style="animation-delay: @(_upcoming.IndexOf(appt) * 0.05)s">
                    <div class="appt-header">
                        <div class="appt-info">
                            <strong>@appt.Title</strong>
                            <span class="appt-meta">
                                📅 @appt.AppointmentDate.ToString("dddd, dd MMM yyyy · HH:mm")
                                @if (!string.IsNullOrEmpty(appt.DoctorName))
                                { <span> · @appt.DoctorName</span> }
                                @if (!string.IsNullOrEmpty(appt.Location))
                                { <span> · 📍 @appt.Location</span> }
                            </span>
                        </div>
                        <button class="bloom-btn secondary small-btn" @onclick="() => MarkComplete(appt)">
                            @T("MarkVisitedButton")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(appt.QuestionsToAsk))
                    {
                        <div class="appt-questions">
                            <strong>@T("QuestionsToAskLabel")</strong>
                            <p>@appt.QuestionsToAsk</p>
                        </div>
                    }
                </div>
            }
        }

        @if (_past.Any())
        {
            <h3 class="list-section-title">@T("PastVisitsHeading")</h3>
            @foreach (var appt in _past)
            {
                <div class="appointment-card past" style="animation-delay: @(_past.IndexOf(appt) * 0.05)s">
                    <div class="appt-header">
                        <div class="appt-info">
                            <strong>@appt.Title</strong>
                            <span class="appt-meta">
                                @appt.AppointmentDate.ToString("dd MMM yyyy")
                                @if (!string.IsNullOrEmpty(appt.DoctorName))
                                { <span> · @appt.DoctorName</span> }
                            </span>
                        </div>
                        <button class="bloom-btn secondary small-btn"
                                @onclick="() => StartAddingNote(appt)">
                            @(string.IsNullOrEmpty(appt.NotesAfterVisit) ? T("AddNotesButton") : T("EditNotesButton"))
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(appt.NotesAfterVisit))
                    {
                        <div class="appt-notes">
                            <strong>@T("MyNotesLabel")</strong>
                            <p>@appt.NotesAfterVisit</p>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private List<AppointmentEntry> _upcoming = [];
    private List<AppointmentEntry> _past = [];
    private bool _adding;
    private string _newTitle = string.Empty;
    private DateTime _newDate = DateTime.Now.AddDays(7);
    private string _newDoctor = string.Empty;
    private string _newLocation = string.Empty;
    private string _newQuestions = string.Empty;
    private AppointmentEntry? _noteTarget;
    private string _noteText = string.Empty;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();

        await LoadAppointmentsAsync();
    }

    private async Task LoadAppointmentsAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var all = await Db.Appointments.Where(a => a.UserId == userId).OrderBy(a => a.AppointmentDate).ToListAsync();
        _upcoming = all.Where(a => !a.Completed).ToList();
        _past = all.Where(a => a.Completed).OrderByDescending(a => a.AppointmentDate).ToList();
    }

    private async Task SaveAppointmentAsync()
    {
        var entry = new AppointmentEntry
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Title = _newTitle,
            // The <input type="datetime-local"> binds a Kind=Unspecified
            // DateTime — Npgsql rejects anything but Utc for a timestamptz
            // column. No real timezone conversion needed here (the app
            // doesn't track per-user timezones), just tag the picked
            // wall-clock value as UTC so it round-trips unchanged.
            AppointmentDate = DateTime.SpecifyKind(_newDate, DateTimeKind.Utc),
            DoctorName = _newDoctor,
            Location = _newLocation,
            QuestionsToAsk = _newQuestions
        };
        Db.Appointments.Add(entry);
        await Db.SaveChangesAsync();
        await CalendarSync.SyncAppointmentAsync(entry.UserId, entry);
        await Db.SaveChangesAsync(); // persists GoogleEventId if sync set it
        _newTitle = _newDoctor = _newLocation = _newQuestions = string.Empty;
        _newDate = DateTime.Now.AddDays(7);
        _adding = false;
        await LoadAppointmentsAsync();
    }

    private async Task MarkComplete(AppointmentEntry appt)
    {
        appt.Completed = true;
        await Db.SaveChangesAsync();
        await CalendarSync.SyncAppointmentAsync(appt.UserId, appt);
        await Db.SaveChangesAsync();
        await LoadAppointmentsAsync();
    }

    private void StartAddingNote(AppointmentEntry appt)
    {
        _noteTarget = appt;
        _noteText = appt.NotesAfterVisit ?? string.Empty;
    }

    private async Task SaveNoteAsync()
    {
        if (_noteTarget == null) return;
        _noteTarget.NotesAfterVisit = _noteText;
        await Db.SaveChangesAsync();
        await CalendarSync.SyncAppointmentAsync(_noteTarget.UserId, _noteTarget);
        await Db.SaveChangesAsync();
        _noteTarget = null;
        await LoadAppointmentsAsync();
    }

