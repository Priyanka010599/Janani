@page "/infant-care"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject BloomAgentRegistry Agents
@inject UserProfileCache ProfileCache
@inject PushNotificationService PushNotifications
@inject IEmailNotificationService EmailNotifications
@inject CareAccessService CareAccess
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Janani — Infant Care</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="baby"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_infants.Any())
    {
        <div class="feeling-grid">
            @foreach (var infant in _infants)
            {
                <button class="feeling-btn @(_selectedInfant?.Id == infant.Id ? "selected" : "")" @onclick="() => SelectInfantAsync(infant)">
                    <span>👶</span>
                    <span class="feeling-label">@infant.Name</span>
                </button>
            }
        </div>
    }
    else if (!_addingInfant)
    {
        <div class="empty-state">
            <p>@T("EmptyTitle")</p>
            <p>@T("EmptyHint")</p>
        </div>
    }

    @if (_addingInfant)
    {
        <div class="appointment-form">
            <h3>@T("AddHeading")</h3>
            <div class="form-row">
                <div class="form-field">
                    <label>@T("NameLabel")</label>
                    <input @bind="_newName" placeholder="@T("NamePlaceholder")" />
                </div>
                <div class="form-field">
                    <label>@T("DobLabel")</label>
                    <input type="date" @bind="_newDateOfBirth" />
                </div>
            </div>
            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveInfantAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">
                    @T("SaveHeart")
                </button>
                <button class="bloom-btn secondary" @onclick="() => _addingInfant = false">@T("Cancel")</button>
            </div>
        </div>
    }
    else
    {
        <button class="bloom-btn secondary new-entry-btn" @onclick="() => _addingInfant = true">
            @T("AddBabyBtn")
        </button>
    }

    @if (_selectedInfant != null)
    {
        <div class="daily-plan">
            <div class="plan-header">
                <span class="week-badge">@_selectedInfant.AgeInWeeks @T("WeeksOld")</span>
                <h2>@string.Format(T("CaringFor"), _selectedInfant.Name)</h2>
                <a class="bloom-btn secondary small-btn" href="@($"/emergency?about=infant-{_selectedInfant.Id}")">🆘 @T("GetHelpBtn")</a>
                <a class="bloom-btn secondary small-btn" href="@($"/infant-care/export/{_selectedInfant.Id}")">🖨️ @T("ExportBtn")</a>
            </div>

            @if (_activeAlert != null)
            {
                <div class="sos-safety-note @(_activeAlert.Severity == AlertSeverity.Critical ? "is-critical" : "is-warning")">
                    <p><Icon Name="sos" Size="16"/> @_activeAlert.Message</p>
                    <a class="bloom-btn primary small-btn" href="@($"/emergency?about=infant-{_selectedInfant.Id}")"><Icon Name="sos" Size="14"/> @T("SendSosBtn")</a>
                    <button class="bloom-btn secondary small-btn" @onclick="AcknowledgeAlertAsync">@T("SeenThisBtn")</button>
                </div>
            }

            <div class="plan-card">
                <h3>🩺 @T("DoctorSectionTitle")</h3>
                <p class="sos-hint">@T("DoctorSectionHint")</p>
                <div class="form-row">
                    <input @bind="_doctorNameInput" placeholder="@T("DoctorNamePlaceholder")" />
                    <input @bind="_doctorEmailInput" placeholder="@T("DoctorEmailPlaceholder")" type="email" />
                </div>
                <button class="bloom-btn secondary small-btn" @onclick="SaveDoctorContactAsync">@T("Save")</button>
                @if (_doctorSaved) { <span class="sos-hint">✅ @T("Saved")</span> }
            </div>

            @if (_selectedInfant.UserId == _currentUserId)
            {
                <div class="plan-card">
                    <h3>👨‍👩‍👧 @T("ShareSectionTitle")</h3>
                    <p class="sos-hint">@string.Format(T("ShareHint"), _selectedInfant.Name)</p>
                    @if (_shares.Count > 0)
                    {
                        <div class="contact-list">
                            @foreach (var share in _shares)
                            {
                                <div class="contact-card">
                                    <div class="contact-info">
                                        <strong>@share.Username</strong>
                                        <span class="contact-relation">@string.Format(T("SharedPrefix"), share.GrantedAt.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                    </div>
                                    <button class="icon-btn" title="@T("RevokeTitle")" aria-label="@string.Format(T("RevokeAriaTemplate"), share.Username)" @onclick="() => RevokeShareAsync(share.ShareId)">✕</button>
                                </div>
                            }
                        </div>
                    }
                    <div class="form-row">
                        <input @bind="_shareUsernameInput" placeholder="@T("UsernamePlaceholder")" />
                    </div>
                    <button class="bloom-btn secondary small-btn" @onclick="ShareInfantAsync">@T("ShareAccessBtn")</button>
                    @if (_shareError != null) { <p class="sos-hint">💗 @_shareError</p> }
                </div>
            }

            <div class="form-row">
                <button class="bloom-btn secondary small-btn" @onclick="() => LogFeedingAsync(FeedingType.Breastfeeding)">🤱 @T("FedBreastBtn")</button>
                <button class="bloom-btn secondary small-btn" @onclick="() => LogFeedingAsync(FeedingType.Formula)">🍼 @T("FedFormulaBtn")</button>
                <button class="bloom-btn secondary small-btn" @onclick="() => LogFeedingAsync(FeedingType.Solid)">🥄 @T("FedSolidBtn")</button>
            </div>

            @if (_lastFeeding != null)
            {
                <p class="sos-hint">@string.Format(T("LastFeedingTemplate"), FeedingTypeLabel(_lastFeeding.Type)) — @FormatAgo(_lastFeeding.FedAt)</p>
            }

            <div class="form-field">
                <label>@T("LogGrowthLabel")</label>
                <div class="form-row">
                    <input type="number" step="0.01" @bind="_growthWeightKg" placeholder="@T("WeightPlaceholder")" />
                    <input type="number" step="0.1" @bind="_growthHeightCm" placeholder="@T("HeightPlaceholder")" />
                    <input type="number" step="0.1" @bind="_growthHeadCm" placeholder="@T("HeadCircPlaceholder")" />
                </div>
                <button class="bloom-btn secondary small-btn" @onclick="SaveGrowthAsync">@T("LogGrowthBtn")</button>
                <button class="bloom-btn secondary small-btn" @onclick="SimulateDeviceSyncAsync" title="@T("SimulateSyncTitle")">
                    🔗 @T("SimulateSyncBtn")
                </button>
            </div>

            @if (_lastGrowthEntry != null)
            {
                <p class="sos-hint">@string.Format(T("LastWeightTemplate"), _lastGrowthEntry.WeightKg) — @(string.IsNullOrEmpty(_lastGrowthEntry.Source) ? T("LoggedManuallyLower") : string.Format(T("SyncedFromTemplateLower"), _lastGrowthEntry.Source))</p>
            }

            @if (_weightTrend.Count >= 2)
            {
                <div class="plan-card">
                    <h3>📈 @T("WeightTrendTitle")</h3>
                    <TrendChart Values="_weightTrend" Unit=" kg" Color="var(--water-deep)" />
                </div>
            }

            <RecommendedReading Topic="@(_selectedInfant.AgeInWeeks < 12 ? "newborn-care" : "infant-sleep")" />

            <div class="plan-card">
                <h3>💉 @T("VaccinationsTitle")</h3>
                <div class="contact-list">
                    @foreach (var v in _vaccineStatuses)
                    {
                        <div class="contact-card @StatusCardClass(v.Status)">
                            <div class="contact-info">
                                <strong>@v.Vaccine.Name</strong>
                                <span class="contact-relation">@string.Format(T("DueTemplate"), v.Vaccine.AgeLabel)</span>
                            </div>
                            @if (v.Status == VaccinationStatus.Given)
                            {
                                <div class="contact-actions">
                                    <span class="family-status">✅ @string.Format(T("GivenOnTemplate"), v.GivenAt?.ToString("MMM d, yyyy"))</span>
                                    <button class="icon-btn" title="@T("UndoTitle")" aria-label="@string.Format(T("UndoAriaTemplate"), v.Vaccine.Name)" @onclick="() => UndoVaccineAsync(v.Vaccine)">↺</button>
                                </div>
                            }
                            else
                            {
                                <div class="contact-actions">
                                    <span class="family-status @(v.Status == VaccinationStatus.Overdue ? "alert" : "")">@StatusLabel(v.Status)</span>
                                    <button class="bloom-btn secondary small-btn" @onclick="() => MarkVaccineGivenAsync(v.Vaccine)">@T("MarkGivenBtn")</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_plan == null)
            {
                <div class="note-section">
                    <label>@T("StatusTodayLabel")</label>
                    <textarea @bind="_statusDescription" placeholder="@T("StatusPlaceholderInfant")" rows="2"></textarea>
                </div>

                <button class="bloom-btn primary" @onclick="GeneratePlanAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_statusDescription) || _generating)">
                    @if (_generating) { <span>@T("CreatingPlan")</span> } else { <span>@T("GetGuidance")</span> }
                </button>

                @if (_error != null)
                {
                    <div class="meal-gentle-note error-note">
                        <p>💗 @_error</p>
                        <button class="bloom-btn secondary small-btn" @onclick="GeneratePlanAsync">@T("TryAgain")</button>
                    </div>
                }
            }
            else
            {
                <div class="plan-card acknowledgment">
                    <p>@_plan.Acknowledgment</p>
                </div>

                <div class="plan-section">
                    <h3>💧 @T("TodaysSmallSteps")</h3>
                    <ul class="suggestion-list">
                        @foreach (var s in _plan.Suggestions)
                        {
                            <li>@s</li>
                        }
                    </ul>
                </div>

                <div class="plan-card week-note">
                    <h3>🌱 @T("AtThisAge")</h3>
                    <p>@_plan.MilestoneNote</p>
                </div>

                <div class="plan-card calming">
                    <h3>📝 @T("ForYou")</h3>
                    <p>@_plan.CaregiverNote</p>
                </div>

                <button class="bloom-btn secondary checkin-again-btn" @onclick="() => _plan = null">
                    @T("CheckInAgain")
                </button>
            }
        </div>
    }
</div>

@code {
    private List<InfantProfile> _infants = [];
    private InfantProfile? _selectedInfant;
    private FeedingLog? _lastFeeding;
    private InfantAlert? _activeAlert;
    private bool _addingInfant;
    private string _newName = string.Empty;
    private DateOnly _newDateOfBirth = DateOnly.FromDateTime(DateTime.Today);
    private string _doctorNameInput = string.Empty;
    private string _doctorEmailInput = string.Empty;
    private bool _doctorSaved;
    private List<ShareInfo> _shares = [];
    private string _shareUsernameInput = string.Empty;
    private string? _shareError;

    private decimal? _growthWeightKg;
    private decimal? _growthHeightCm;
    private decimal? _growthHeadCm;
    private List<decimal> _weightTrend = [];
    private GrowthEntry? _lastGrowthEntry;

    private string _statusDescription = string.Empty;
    private InfantDailyPlan? _plan;
    private bool _generating;
    private string? _error;
    private CancellationTokenSource? _cts;

    private List<VaccinationSchedule.VaccineWithStatus> _vaccineStatuses = [];

    private int _currentUserId;
    private string _language = "English";
    private CareContext _careContext = new(null);

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await CurrentUser.GetUserIdAsync();
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();
        _careContext = profile?.CareContext ?? new CareContext(null);

        // Unreachable, not just hidden — a bereaved profile with no
        // surviving infant is redirected away even on a direct URL visit,
        // not merely kept off the nav (see NavMenu.razor for the nav side
        // of this same gate). PartialLossMultiple stays reachable — its
        // surviving child's own data still lives here.
        if (_careContext.SuppressInfantContent)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        await LoadInfantsAsync();
    }

    private async Task LoadInfantsAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var accessibleIds = await CareAccess.GetAccessibleInfantIdsAsync(userId);
        _infants = await Db.InfantProfiles.AsNoTracking()
            .Where(i => accessibleIds.Contains(i.Id))
            .OrderBy(i => i.Name)
            .ToListAsync();
    }

    private async Task SaveInfantAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;

        Db.InfantProfiles.Add(new InfantProfile
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Name = _newName.Trim(),
            DateOfBirth = _newDateOfBirth
        });
        await Db.SaveChangesAsync();

        _newName = string.Empty;
        _newDateOfBirth = DateOnly.FromDateTime(DateTime.Today);
        _addingInfant = false;
        await LoadInfantsAsync();
    }

    private async Task SelectInfantAsync(InfantProfile infant)
    {
        _selectedInfant = infant;
        _plan = null;
        _statusDescription = string.Empty;
        _doctorNameInput = infant.DoctorName ?? string.Empty;
        _doctorEmailInput = infant.DoctorEmail ?? string.Empty;
        _doctorSaved = false;
        _lastFeeding = await Db.FeedingLogs.AsNoTracking()
            .Where(f => f.InfantProfileId == infant.Id)
            .OrderByDescending(f => f.FedAt)
            .FirstOrDefaultAsync();
        _activeAlert = await Db.InfantAlerts.AsNoTracking()
            .Where(a => a.InfantProfileId == infant.Id && !a.Acknowledged)
            .OrderByDescending(a => a.TriggeredAt)
            .FirstOrDefaultAsync();
        await LoadVaccinationStatusAsync();
        await LoadWeightTrendAsync();

        _shareUsernameInput = string.Empty;
        _shareError = null;
        _shares = infant.UserId == _currentUserId
            ? await CareAccess.GetSharesForInfantAsync(infant.Id)
            : [];
    }

    private async Task ShareInfantAsync()
    {
        if (_selectedInfant == null || string.IsNullOrWhiteSpace(_shareUsernameInput)) return;
        _shareError = await CareAccess.GrantInfantAccessAsync(_selectedInfant.Id, _shareUsernameInput, _currentUserId);
        if (_shareError == null)
        {
            _shareUsernameInput = string.Empty;
            _shares = await CareAccess.GetSharesForInfantAsync(_selectedInfant.Id);
        }
    }

    private async Task RevokeShareAsync(int shareId)
    {
        if (_selectedInfant == null) return;
        await CareAccess.RevokeAsync(shareId, _currentUserId);
        _shares = await CareAccess.GetSharesForInfantAsync(_selectedInfant.Id);
    }

    private async Task LoadWeightTrendAsync()
    {
        if (_selectedInfant == null) return;
        var recentEntries = await Db.GrowthEntries.AsNoTracking()
            .Where(g => g.InfantProfileId == _selectedInfant.Id && g.WeightKg != null)
            .OrderByDescending(g => g.RecordedAt)
            .Take(10)
            .ToListAsync();
        _lastGrowthEntry = recentEntries.FirstOrDefault();
        recentEntries.Reverse();
        _weightTrend = recentEntries.Select(g => g.WeightKg!.Value).ToList();
    }

    private async Task SaveDoctorContactAsync()
    {
        if (_selectedInfant == null) return;
        var name = string.IsNullOrWhiteSpace(_doctorNameInput) ? null : _doctorNameInput.Trim();
        var email = string.IsNullOrWhiteSpace(_doctorEmailInput) ? null : _doctorEmailInput.Trim();

        await Db.InfantProfiles.Where(i => i.Id == _selectedInfant.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(i => i.DoctorName, name)
                .SetProperty(i => i.DoctorEmail, email));

        _selectedInfant.DoctorName = name;
        _selectedInfant.DoctorEmail = email;
        _doctorSaved = true;
    }

    private async Task AcknowledgeAlertAsync()
    {
        if (_activeAlert == null) return;
        var alert = await Db.InfantAlerts.FindAsync(_activeAlert.Id);
        if (alert != null)
        {
            alert.Acknowledged = true;
            await Db.SaveChangesAsync();
        }
        _activeAlert = null;
    }

    private async Task LoadVaccinationStatusAsync()
    {
        if (_selectedInfant == null) return;

        var given = await Db.VaccinationRecords.AsNoTracking()
            .Where(v => v.InfantProfileId == _selectedInfant.Id)
            .ToListAsync();
        _vaccineStatuses = VaccinationSchedule.BuildStatus(_selectedInfant.AgeInWeeks, given, suppressed: _careContext.SuppressInfantContent)
            .OrderBy(v => v.Status switch
            {
                VaccinationStatus.Overdue => 0,
                VaccinationStatus.DueNow => 1,
                VaccinationStatus.Upcoming => 2,
                _ => 3
            })
            .ToList();
    }

    private async Task MarkVaccineGivenAsync(VaccinationSchedule.ScheduledVaccine vaccine)
    {
        if (_selectedInfant == null) return;

        Db.VaccinationRecords.Add(new VaccinationRecord
        {
            InfantProfileId = _selectedInfant.Id,
            VaccineName = vaccine.Name
        });
        await Db.SaveChangesAsync();
        await LoadVaccinationStatusAsync();
    }

    private async Task UndoVaccineAsync(VaccinationSchedule.ScheduledVaccine vaccine)
    {
        if (_selectedInfant == null) return;

        var record = await Db.VaccinationRecords
            .Where(v => v.InfantProfileId == _selectedInfant.Id && v.VaccineName == vaccine.Name)
            .FirstOrDefaultAsync();
        if (record == null) return;

        Db.VaccinationRecords.Remove(record);
        await Db.SaveChangesAsync();
        await LoadVaccinationStatusAsync();
    }

    private static string StatusCardClass(VaccinationStatus status) => status switch
    {
        VaccinationStatus.Overdue => "is-alert-critical",
        VaccinationStatus.DueNow => "is-alert-warning",
        _ => ""
    };

    private string StatusLabel(VaccinationStatus status) => status switch
    {
        VaccinationStatus.Overdue => $"🚨 {T("OverdueLabel")}",
        VaccinationStatus.DueNow => $"⚠️ {T("DueNowLabel")}",
        _ => T("UpcomingLabel")
    };

    private string FeedingTypeLabel(FeedingType type) => type switch
    {
        FeedingType.Breastfeeding => T("Breastfeeding"),
        FeedingType.Formula => T("Formula"),
        FeedingType.Solid => T("Solid"),
        _ => type.ToString()
    };

    private async Task LogFeedingAsync(FeedingType type)
    {
        if (_selectedInfant == null) return;

        var log = new FeedingLog { InfantProfileId = _selectedInfant.Id, Type = type };
        Db.FeedingLogs.Add(log);
        await Db.SaveChangesAsync();
        _lastFeeding = log;
    }

    private async Task SaveGrowthAsync()
    {
        if (_selectedInfant == null) return;

        var entry = new GrowthEntry
        {
            InfantProfileId = _selectedInfant.Id,
            WeightKg = _growthWeightKg,
            HeightCm = _growthHeightCm,
            HeadCircumferenceCm = _growthHeadCm
        };

        _growthWeightKg = null;
        _growthHeightCm = null;
        _growthHeadCm = null;

        await ProcessGrowthEntryAsync(entry);
    }

    // Stands in for a real device-cloud sync (e.g. a Withings smart scale)
    // until one is wired up — see ElderCare.razor's SimulateDeviceSyncAsync
    // for the same pattern on the vitals side.
    private static readonly Random _deviceRandom = new();

    private async Task SimulateDeviceSyncAsync()
    {
        if (_selectedInfant == null) return;

        var previousWeight = await Db.GrowthEntries.AsNoTracking()
            .Where(g => g.InfantProfileId == _selectedInfant.Id && g.WeightKg != null)
            .OrderByDescending(g => g.RecordedAt)
            .Select(g => g.WeightKg)
            .FirstOrDefaultAsync();

        // Small plausible step up from the last known weight (or a
        // reasonable default for this age if there's no history yet),
        // occasionally flat/down to demonstrate the stalled-growth check.
        var baseline = previousWeight ?? (3.3m + (decimal)_selectedInfant.AgeInWeeks * 0.15m);
        var delta = _deviceRandom.NextDouble() < 0.2 ? (decimal)(_deviceRandom.NextDouble() * 0.1 - 0.05) : (decimal)(_deviceRandom.NextDouble() * 0.25 + 0.05);
        var entry = new GrowthEntry
        {
            InfantProfileId = _selectedInfant.Id,
            WeightKg = Math.Round(baseline + delta, 2),
            Source = "Withings Body smart scale (simulated)"
        };

        await ProcessGrowthEntryAsync(entry);
    }

    private async Task ProcessGrowthEntryAsync(GrowthEntry entry)
    {
        if (_selectedInfant == null) return;

        var previous = await Db.GrowthEntries.AsNoTracking()
            .Where(g => g.InfantProfileId == _selectedInfant.Id)
            .OrderByDescending(g => g.RecordedAt)
            .FirstOrDefaultAsync();

        Db.GrowthEntries.Add(entry);
        await Db.SaveChangesAsync();
        await LoadWeightTrendAsync();

        // Deterministic check, no LLM involved — see GrowthThresholdChecker.
        var concerns = GrowthThresholdChecker.Check(_selectedInfant, entry, previous);
        if (concerns.Count > 0)
        {
            var alert = new InfantAlert
            {
                InfantProfileId = _selectedInfant.Id,
                GrowthEntryId = entry.Id,
                Severity = concerns.Any(c => c.Severity == AlertSeverity.Critical) ? AlertSeverity.Critical : AlertSeverity.Warning,
                Message = string.Join(" ", concerns.Select(c => c.Description))
            };
            Db.InfantAlerts.Add(alert);
            await Db.SaveChangesAsync();
            _activeAlert = alert;

            var prefix = alert.Severity == AlertSeverity.Critical ? "🚨" : "⚠️";

            // Every caregiver with access gets pushed, not just whoever was
            // logging the entry — see ElderCare.razor's NotifyElderAlertAsync.
            var caregiverIds = await CareAccess.GetCaregiverUserIdsForInfantAsync(_selectedInfant.Id);
            foreach (var caregiverId in caregiverIds)
            {
                await PushNotifications.NotifyUserViaPubSubAsync(caregiverId, $"{prefix} {_selectedInfant.Name} — growth concern", alert.Message, "infant-checker", NotificationScope.Infant, infantProfileId: _selectedInfant.Id);
            }

            // Only Critical escalates to the doctor by email. Sent once, by
            // the app itself through one centrally-configured sender — no
            // caregiver connects an account, and none of them ever sees a
            // credential (see IEmailNotificationService).
            if (alert.Severity == AlertSeverity.Critical && !string.IsNullOrWhiteSpace(_selectedInfant.DoctorEmail))
            {
                var subject = $"Urgent: {_selectedInfant.Name} may need attention (via Janani)";
                var body = $"{alert.Message}\n\nThis is an automated alert from Janani, a family caregiving app, " +
                           $"sent on behalf of {_selectedInfant.Name}'s caregiver because a critical concern was flagged.";
                var doctorLabel = _selectedInfant.DoctorName ?? "Doctor";
                var doctorEmailSent = await EmailNotifications.SendDoctorAlertAsync(_selectedInfant.DoctorEmail!, doctorLabel, subject, body);
                if (!doctorEmailSent)
                {
                    foreach (var caregiverId in caregiverIds)
                    {
                        await PushNotifications.NotifyUserViaPubSubAsync(caregiverId, $"⚠️ Couldn't email {doctorLabel}",
                            $"The automatic alert email to {doctorLabel} about {_selectedInfant.Name} failed to send — please contact them directly.",
                            "infant-checker", NotificationScope.Infant, infantProfileId: _selectedInfant.Id);
                    }
                }
            }
        }
    }

    private async Task GeneratePlanAsync()
    {
        if (_selectedInfant == null || string.IsNullOrWhiteSpace(_statusDescription)) return;
        _generating = true;
        _error = null;
        StateHasChanged();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var activitySummary = _lastFeeding != null
                ? $"Last fed ({_lastFeeding.Type}) {FormatAgo(_lastFeeding.FedAt)}"
                : null;
            var language = (await ProfileCache.GetAsync())?.Language ?? AppLanguage.English;
            _plan = await Agents.InfantCare.GenerateDailyPlanAsync(
                _selectedInfant, _statusDescription, activitySummary, language, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _error = T("GenericRetryError");
        }

        _generating = false;
    }

    private string FormatAgo(DateTime at)
    {
        var span = DateTime.UtcNow - at;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}{T("MinAgo")}";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}{T("HourAgo")}";
        return $"{(int)span.TotalDays}{T("DayAgo")}";
    }

    public void Dispose() => _cts?.Cancel();

    private static readonly Dictionary<string, Dictionary<string, string>> Strings = new()
    {
        ["English"] = new()
        {
            ["Title"] = "Infant Care",
            ["Subtitle"] = "Log feeding and sleep, track growth, and get a gentle daily plan.",
            ["EmptyTitle"] = "No one added yet 🌷",
            ["EmptyHint"] = "Add your baby to start tracking.",
            ["AddHeading"] = "Add your baby",
            ["NameLabel"] = "Name",
