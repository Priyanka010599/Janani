@page "/birthplan"
@using Janani.Services
@inject BloomAgentRegistry Agents
@inject UserProfileCache ProfileCache
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Janani — Birth Plan Builder</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="birthplan"/> @T("Title")</h1>
        <p class="subtitle">
            @T("Subtitle")
        </p>
    </div>

    @if (!_started)
    {
        <div class="birthplan-intro">
            <div class="intro-card">
                <h3>@T("HowThisWorks")</h3>
                <p>@T("IntroBefore") @Agents.BirthPlan.TotalSteps @T("IntroAfter")</p>
                <p class="intro-note">
                    💗 @T("IntroNote")
                </p>
            </div>
            <button class="bloom-btn primary" @onclick="Start">
                @T("LetsBegin")
            </button>
        </div>
    }
    else if (!Agents.BirthPlan.IsComplete)
    {
        <div class="birthplan-progress">
            <div class="progress-bar-wrap">
                <div class="progress-bar"
                     style="width: @(((Agents.BirthPlan.CurrentStepNumber - 1) * 100) / Agents.BirthPlan.TotalSteps)%">
                </div>
            </div>
            <span class="progress-label">@T("Step") @Agents.BirthPlan.CurrentStepNumber @T("Of") @Agents.BirthPlan.TotalSteps</span>
        </div>

        <div class="birthplan-question">
            <div class="bloom-question-bubble" @key="Agents.BirthPlan.CurrentStepNumber">
                🌸 @(_agentResponse ?? Agents.BirthPlan.CurrentQuestion)
            </div>

            <div class="form-field" style="margin-top:1rem;">
                <div class="input-with-voice">
                    <textarea @bind="_currentAnswer"
                              placeholder="@T("AnswerPlaceholder")"
                              rows="4"></textarea>
                    <VoiceInput OnTranscript="t => _currentAnswer = t" />
                </div>
            </div>

            <button class="bloom-btn primary" @onclick="SubmitAnswerAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_currentAnswer) || _processing)">
                @(_processing ? T("Processing") : T("Next"))
            </button>
        </div>
    }
    else
    {
        <div class="birthplan-complete">
            <div class="complete-header">
                <h2>✨ @T("YourBirthPlan")</h2>
                <p>@T("PlanIntro")</p>
            </div>
            <div class="plan-document">
                @_planDocument
                @if (_generatingPlan)
                {
                    <span class="typing-dot">▋</span>
                }
            </div>
            @if (!_generatingPlan)
            {
                <div class="form-actions" style="margin-top:1rem;">
                    <button class="bloom-btn secondary" @onclick="ResetPlan">@T("StartOver")</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _started;
    private bool _processing;
    private bool _generatingPlan;
    private string _currentAnswer = string.Empty;
    private string? _agentResponse;
    private string _planDocument = string.Empty;
    private CancellationTokenSource? _cts;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();
    }

    private async Task<AgentContext> BuildContextAsync()
    {
        var profile = await ProfileCache.GetAsync();
        return new AgentContext(
            profile?.Name ?? "Mama",
            profile?.CurrentWeek ?? 30,
            profile?.Language ?? AppLanguage.English,
            profile?.WorkingWomanMode ?? true);
    }

    private void Start()
    {
        Agents.BirthPlan.Reset();
        _started = true;
        _agentResponse = null;
    }

    private async Task SubmitAnswerAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentAnswer)) return;
        _processing = true;
        var answer = _currentAnswer;
        _currentAnswer = string.Empty;
        _agentResponse = null;
        StateHasChanged();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var context = await BuildContextAsync();
            var sb = new System.Text.StringBuilder();
            var lastRender = DateTime.UtcNow;
            await foreach (var token in Agents.BirthPlan.ProcessAnswerAsync(answer, context, _cts.Token))
            {
                sb.Append(token);
                if (Agents.BirthPlan.IsComplete)
                {
                    // Streaming the birth plan document
                    _generatingPlan = true;
                    _planDocument = sb.ToString();
                }
                else
                {
                    _agentResponse = sb.ToString();
                }

                // Batch renders — one SignalR round-trip per ~100ms instead of per token
                if ((DateTime.UtcNow - lastRender).TotalMilliseconds >= 100)
                {
                    lastRender = DateTime.UtcNow;
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException) { }

        _generatingPlan = false;
        _processing = false;
        StateHasChanged();
    }

    private void ResetPlan()
    {
        _started = false;
        _processing = false;
        _agentResponse = null;
        _planDocument = string.Empty;
        _currentAnswer = string.Empty;
        Agents.BirthPlan.Reset();
    }

    public void Dispose() => _cts?.Cancel();

    // Small, hand-maintained dictionary rather than a full resx pipeline —
    // same approach as Recipes.razor / NavMenu.razor. Only the page's own
    // static UI chrome is translated here; agent responses (_agentResponse,
