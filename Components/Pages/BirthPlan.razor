            ["LetsBegin"] = "Let's begin 🌸",
            ["Step"] = "Step",
            ["Of"] = "of",
            ["AnswerPlaceholder"] = "Take your time — write whatever feels right...",
            ["Processing"] = "Processing... 💗",
            ["Next"] = "Next →",
            ["YourBirthPlan"] = "Your birth plan",
            ["PlanIntro"] = "Here is your personal birth plan, built from your own words.",
            ["StartOver"] = "Start over",
        },
        ["Hindi"] = new()
        {
            ["Title"] = "प्रसव योजना निर्माता",
            ["Subtitle"] = "यहां कोई सही जवाब नहीं है — केवल आपकी इच्छाएं हैं। हम इसे धीरे-धीरे, एक-एक कदम करके पूरा करेंगे। आप कभी भी वापस आकर कुछ भी बदल सकती हैं।",
            ["HowThisWorks"] = "यह कैसे काम करता है",
            ["IntroBefore"] = "जननी आपसे प्रसव और जन्म से जुड़ी आपकी पसंद के बारे में",
            ["IntroAfter"] = "सरल सवाल पूछेगी। कोई गलत जवाब नहीं है — बस आपकी इच्छाएं। अंत में, आपके पास एक कोमल, व्यक्तिगत प्रसव योजना दस्तावेज़ होगा, जिसे आप अपनी देखभाल टीम के साथ साझा कर सकती हैं।",
            ["IntroNote"] = "प्रसव योजना एक मार्गदर्शक है, कोई अनुबंध नहीं। यह आपकी देखभाल टीम को यह समझने में मदद करती है कि आपके लिए सबसे महत्वपूर्ण क्या है।",
            ["LetsBegin"] = "चलिए शुरू करें 🌸",
            ["Step"] = "चरण",
            ["Of"] = "में से",
            ["AnswerPlaceholder"] = "अपना समय लें — जो सही लगे वह लिखें...",
            ["Processing"] = "प्रोसेस हो रहा है... 💗",
            ["Next"] = "आगे →",
            ["YourBirthPlan"] = "आपकी प्रसव योजना",
            ["PlanIntro"] = "यह रही आपकी व्यक्तिगत प्रसव योजना, आपके ही शब्दों से बनाई गई।",
            ["StartOver"] = "फिर से शुरू करें",
        },
        ["Telugu"] = new()
        {
            ["Title"] = "ప్రసవ ప్రణాళిక నిర్మాత",
            ["Subtitle"] = "ఇక్కడ సరైన సమాధానాలు లేవు — మీ కోరికలు మాత్రమే ఉన్నాయి. మేము దీన్ని నెమ్మదిగా, ఒక్కో అడుగులో పూర్తి చేస్తాము. మీరు ఎప్పుడైనా తిరిగి వచ్చి దేన్నైనా మార్చుకోవచ్చు.",
            ["HowThisWorks"] = "ఇది ఎలా పని చేస్తుంది",
            ["IntroBefore"] = "జననీ మీ ప్రసవం మరియు జననానికి సంబంధించిన మీ ప్రాధాన్యతల గురించి",
