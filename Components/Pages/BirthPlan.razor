            ["IntroNote"] = "ప్రసవ ప్రణాళిక ఒక మార్గదర్శిని, ఒప్పందం కాదు. ఇది మీకు అత్యంత ముఖ్యమైనది ఏమిటో అర్థం చేసుకోవడానికి మీ సంరక్షణ బృందానికి సహాయపడుతుంది.",
            ["LetsBegin"] = "మొదలుపెడదాం 🌸",
            ["Step"] = "దశ",
            ["Of"] = "లో",
            ["AnswerPlaceholder"] = "మీ సమయం తీసుకోండి — మీకు సరైనదిగా అనిపించేది రాయండి...",
            ["Processing"] = "ప్రాసెస్ అవుతోంది... 💗",
            ["Next"] = "తదుపరి →",
            ["YourBirthPlan"] = "మీ ప్రసవ ప్రణాళిక",
