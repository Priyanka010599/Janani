@page "/how-it-works"
@using Janani.Models
@using Janani.Services
@inject BloomAgentRegistry Agents
@inject UserProfileCache ProfileCache
@rendermode InteractiveServer

<PageTitle>Janani — How it decides</PageTitle>

@{
    // Recomputed on every render, on purpose: the whole point of this page is
    // that the verdict below is a pure function of the numbers above it. No
    // model call, no I/O -- VitalsThresholdChecker.Check is plain C#.
    var concerns = VitalsThresholdChecker.Check(BuildReading());
    var severity = concerns.Any(c => c.Severity == AlertSeverity.Critical) ? AlertSeverity.Critical : AlertSeverity.Warning;
    var explanationIsCurrent = _explanation != null && _explainedFor == Signature();
}

<div class="bloom-container guardrail-wide">
    <div class="section-header">
        <h1><Icon Name="vitals"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    <p class="data-source-note">@T("SampleNote")</p>

    <div class="guardrail-steps">

        <div class="plan-card guardrail-step">
            <h3>@T("Step1")</h3>
            <div class="guardrail-presets">
                <button class="bloom-btn secondary small-btn" @onclick="() => Preset(122, 78, 72, 36.8m, 97)">@T("PresetNormal")</button>
                <button class="bloom-btn secondary small-btn" @onclick="() => Preset(128, 80, 132, 36.9m, 96)">@T("PresetWarning")</button>
                <button class="bloom-btn secondary small-btn" @onclick="() => Preset(192, 104, 140, 39.5m, 85)">@T("PresetCritical")</button>
            </div>
            <div class="form-field">
                <label>@T("Systolic")</label>
                <input type="number" @bind="_sys" @bind:event="oninput" />
            </div>
            <div class="form-field">
                <label>@T("Diastolic")</label>
                <input type="number" @bind="_dia" @bind:event="oninput" />
            </div>
            <div class="form-field">
                <label>@T("HeartRate")</label>
                <input type="number" @bind="_hr" @bind:event="oninput" />
            </div>
            <div class="form-field">
                <label>@T("Temperature")</label>
                <input type="number" step="0.1" @bind="_temp" @bind:event="oninput" />
            </div>
            <div class="form-field">
                <label>@T("Oxygen")</label>
                <input type="number" @bind="_spo2" @bind:event="oninput" />
            </div>
        </div>

        <div class="plan-card guardrail-step guardrail-checker">
            <h3>@T("Step2")</h3>
            <p class="data-source-note">@T("CheckerNote")</p>
            @if (concerns.Count == 0)
            {
                <p class="guardrail-verdict guardrail-ok">@T("NoConcern")</p>
                <p class="data-source-note">@T("NoConcernHint")</p>
            }
            else
            {
                <p class="guardrail-verdict @(severity == AlertSeverity.Critical ? "guardrail-critical" : "guardrail-warning")">
                    @(severity == AlertSeverity.Critical ? T("VerdictCritical") : T("VerdictWarning"))
                </p>
                <ul class="guardrail-concerns">
                    @foreach (var c in concerns)
                    {
                        <li>
                            <span class="guardrail-sev @(c.Severity == AlertSeverity.Critical ? "sev-critical" : "sev-warning")">@(c.Severity == AlertSeverity.Critical ? T("Critical") : T("Warning"))</span>
                            @c.Description
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="plan-card guardrail-step">
            <h3>@T("Step3")</h3>
            @if (concerns.Count == 0)
            {
                <p class="data-source-note">@T("NothingToExplain")</p>
            }
            else
            {
                <div class="form-field">
                    <label>@T("Language")</label>
                    <select @bind="_lang">
                        <option value="English">English</option>
                        <option value="Hindi">हिंदी</option>
                        <option value="Telugu">తెలుగు</option>
                    </select>
                </div>
                <button class="bloom-btn primary" @onclick="ExplainAsync" disabled="@_busy">
                    @(_busy ? T("Explaining") : T("Explain"))
                </button>
                @if (_error != null)
                {
                    <p class="medicine-explanation medicine-explanation-error">@_error</p>
                }
                @if (explanationIsCurrent)
                {
                    <p class="guardrail-explanation">@_explanation</p>
                    @if (!string.IsNullOrWhiteSpace(_action))
                    {
                        <p class="data-source-note"><strong>@T("SuggestedAction"):</strong> @_action</p>
                    }
                }
            }
        </div>

    </div>

    <p class="data-source-note guardrail-footer">@T("Footer")</p>
</div>

@code {
    private int? _sys = 192, _dia = 104, _hr = 140, _spo2 = 85;
    private decimal? _temp = 39.5m;
    private string _lang = "English";

    private string? _explanation;
    private string? _action;
    private string? _explainedFor;
    private string? _error;
    private bool _busy;
    private string _uiLanguage = "English";

    // A sample dependent, not a real profile: this page is a demonstration of
    // the pipeline, so nothing typed here is ever saved or alerted on.
    private static readonly ElderProfile SampleElder = new() { Name = "Lakshmi", Age = 68, Relation = "Mother" };

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileCache.GetAsync();
        _uiLanguage = (profile?.Language ?? AppLanguage.English).ToString();
        if (_uiLanguage is "English" or "Hindi" or "Telugu") _lang = _uiLanguage;
    }

    private VitalsReading BuildReading() => new()
    {
        SystolicBp = _sys,
        DiastolicBp = _dia,
        HeartRate = _hr,
        TemperatureC = _temp,
        OxygenSaturation = _spo2
    };

    private string Signature() => $"{_sys}|{_dia}|{_hr}|{_temp}|{_spo2}|{_lang}";

    private void Preset(int sys, int dia, int hr, decimal temp, int spo2)
    {
        (_sys, _dia, _hr, _temp, _spo2) = (sys, dia, hr, temp, spo2);
        _explanation = null;
        _error = null;
    }

    private async Task ExplainAsync()
    {
        var concerns = VitalsThresholdChecker.Check(BuildReading());
        // The gate the page exists to demonstrate: no concern, no model call.
        if (concerns.Count == 0) return;

        var severity = concerns.Any(c => c.Severity == AlertSeverity.Critical) ? AlertSeverity.Critical : AlertSeverity.Warning;
        var language = Enum.TryParse<AppLanguage>(_lang, out var parsed) ? parsed : AppLanguage.English;

        _busy = true;
        _error = null;
        try
        {
            var (explanation, action) = await Agents.HealthMonitor.ExplainAsync(SampleElder, concerns, severity, language);
            _explanation = explanation;
            _action = action;
            _explainedFor = Signature();
        }
        catch (Exception)
        {
            _error = T("ExplainError");
        }
        finally
        {
            _busy = false;
        }
    }

