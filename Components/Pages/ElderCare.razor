@page "/elder-care"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject BloomAgentRegistry Agents
@inject UserProfileCache ProfileCache
@inject CareAccessService CareAccess
@inject VitalsIngestService VitalsIngest
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Janani — Elder Care</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1>🌼 @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_elders.Any())
    {
        <div class="feeling-grid">
            @foreach (var elder in _elders)
            {
                <button class="feeling-btn @(_selectedElder?.Id == elder.Id ? "selected" : "")" @onclick="() => SelectElderAsync(elder)">
                    <span>👤</span>
                    <span class="feeling-label">@elder.Name</span>
                </button>
            }
        </div>
    }
    else if (!_addingElder)
    {
        <div class="empty-state">
            <p>@T("EmptyTitle")</p>
            <p>@T("EmptyHint")</p>
        </div>
    }

    @if (_addingElder)
    {
        <div class="appointment-form">
            <h3>@T("AddHeading")</h3>
            <div class="form-row">
                <div class="form-field">
                    <label>@T("NameLabel")</label>
                    <input @bind="_newName" placeholder="@T("NamePlaceholder")" />
                </div>
                <div class="form-field">
                    <label>@T("AgeLabel")</label>
                    <input type="number" @bind="_newAge" min="0" max="120" />
                </div>
            </div>
            <div class="form-field">
                <label>@T("RelationLabel")</label>
                <input @bind="_newRelation" placeholder="@T("RelationPlaceholder")" />
            </div>
            <div class="form-field">
                <label>@T("MedicalNotesLabel")</label>
                <textarea @bind="_newMedicalNotes" placeholder="@T("MedicalNotesPlaceholder")" rows="2"></textarea>
            </div>
            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveElderAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">
                    @T("SaveHeart")
                </button>
                <button class="bloom-btn secondary" @onclick="() => _addingElder = false">@T("Cancel")</button>
            </div>
        </div>
    }
    else
    {
        <button class="bloom-btn secondary new-entry-btn" @onclick="() => _addingElder = true">
            @T("AddSomeoneBtn")
        </button>
    }

    @if (_selectedElder != null)
    {
        <div class="daily-plan">
            <div class="plan-header">
                <h2>@string.Format(T("CaringFor"), _selectedElder.Name)</h2>
                <a class="bloom-btn secondary small-btn" href="@($"/elder-care/export/{_selectedElder.Id}")">🖨️ @T("ExportBtn")</a>
                <a class="bloom-btn secondary small-btn" href="@($"/elder-mode/{_selectedElder.Id}")">👵 @T("ElderModeBtn")</a>
            </div>

            @if (_activeAlert != null)
            {
                <div class="sos-safety-note">
                    <p>@(_activeAlert.Severity == AlertSeverity.Critical ? "🚨" : "⚠️") @_activeAlert.Message</p>
                    <a class="bloom-btn primary small-btn" href="@($"/emergency?about=elder-{_selectedElder.Id}")">🆘 @T("SendSosBtn")</a>
                    <button class="bloom-btn secondary small-btn" @onclick="AcknowledgeAlertAsync">@T("SeenThisBtn")</button>
                </div>
            }

            <div class="plan-card">
                <h3>🩺 @T("DoctorSectionTitle")</h3>
                <p class="sos-hint">@T("DoctorSectionHint")</p>
                <div class="form-row">
                    <input @bind="_doctorNameInput" placeholder="@T("DoctorNamePlaceholder")" />
                    <input @bind="_doctorEmailInput" placeholder="@T("DoctorEmailPlaceholder")" type="email" />
                </div>
                <button class="bloom-btn secondary small-btn" @onclick="SaveDoctorContactAsync">@T("Save")</button>
                @if (_doctorSaved) { <span class="sos-hint">✅ @T("Saved")</span> }
            </div>

            @if (_selectedElder.UserId == _currentUserId)
            {
                <div class="plan-card">
                    <h3>👨‍👩‍👧 @T("ShareSectionTitle")</h3>
                    <p class="sos-hint">@string.Format(T("ShareHint"), _selectedElder.Name)</p>
                    @if (_shares.Count > 0)
                    {
                        <div class="contact-list">
                            @foreach (var share in _shares)
                            {
                                <div class="contact-card">
                                    <div class="contact-info">
                                        <strong>@share.Username</strong>
                                        <span class="contact-relation">@string.Format(T("SharedPrefix"), share.GrantedAt.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                    </div>
                                    <button class="icon-btn" title="@T("RevokeTitle")" aria-label="@string.Format(T("RevokeAriaTemplate"), share.Username)" @onclick="() => RevokeShareAsync(share.ShareId)">✕</button>
                                </div>
                            }
                        </div>
                    }
                    <div class="form-row">
                        <input @bind="_shareUsernameInput" placeholder="@T("UsernamePlaceholder")" />
                    </div>
                    <button class="bloom-btn secondary small-btn" @onclick="ShareElderAsync">@T("ShareAccessBtn")</button>
                    @if (_shareError != null) { <p class="sos-hint">💗 @_shareError</p> }
                </div>
            }

            @if (_recentVitals != null)
            {
                <div class="plan-card">
                    <h3>🩺 @T("LastVitalsTitle")</h3>
                    <p>@BuildVitalsSummary(_recentVitals) — @FormatAgo(_recentVitals.RecordedAt)</p>
                    <p class="sos-hint">@(string.IsNullOrEmpty(_recentVitals.Source) ? T("LoggedManually") : string.Format(T("SyncedFromTemplate"), _recentVitals.Source))</p>
                </div>
            }

            @if (_systolicTrend.Count >= 2)
            {
                <div class="plan-card">
                    <h3>📈 @T("SystolicTrendTitle")</h3>
                    <TrendChart Values="_systolicTrend" Unit=" mmHg" Color="var(--urgent)" />
                </div>
            }

            <RecommendedReading Topic="elder-caregiving" />

            <div class="form-field">
                <label>@T("LogVitalsLabel")</label>
                <div class="form-row">
                    <input type="number" @bind="_vitalsSystolic" placeholder="@T("SystolicPlaceholder")" />
                    <input type="number" @bind="_vitalsDiastolic" placeholder="@T("DiastolicPlaceholder")" />
                    <input type="number" @bind="_vitalsHeartRate" placeholder="@T("HeartRatePlaceholder")" />
                </div>
                <div class="form-row">
                    <input type="number" step="0.1" @bind="_vitalsTemperature" placeholder="@T("TempPlaceholder")" />
                    <input type="number" @bind="_vitalsOxygen" placeholder="@T("OxygenPlaceholder")" />
                </div>
                <button class="bloom-btn secondary small-btn" @onclick="SaveVitalsAsync" disabled="@_checkingVitals">
                    @(_checkingVitals ? T("CheckingBtn") : T("LogVitalsBtn"))
                </button>
                <button class="bloom-btn secondary small-btn" @onclick="SimulateDeviceSyncAsync" disabled="@_checkingVitals" title="@T("SimulateSyncTitle")">
                    🔗 @T("SimulateSyncBtn")
                </button>
            </div>

            @if (_plan == null)
            {
                <div class="note-section">
                    <label>@T("MoodLabel")</label>
                    <textarea @bind="_moodDescription" placeholder="@T("MoodPlaceholder")" rows="2"></textarea>
                </div>

                <button class="bloom-btn primary" @onclick="GeneratePlanAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_moodDescription) || _generating)">
                    @if (_generating) { <span>@T("CreatingPlan")</span> } else { <span>@T("GetGuidance")</span> }
                </button>

                @if (_error != null)
                {
                    <div class="meal-gentle-note error-note">
                        <p>💗 @_error</p>
                        <button class="bloom-btn secondary small-btn" @onclick="GeneratePlanAsync">@T("TryAgain")</button>
                    </div>
                }
            }
            else
            {
                <div class="plan-card acknowledgment">
                    <p>@_plan.Acknowledgment</p>
                </div>

                <div class="plan-section">
                    <h3>💧 @T("TodaysSmallSteps")</h3>
                    <ul class="suggestion-list">
                        @foreach (var s in _plan.Suggestions)
                        {
                            <li>@s</li>
                        }
                    </ul>
                </div>

                <div class="plan-card calming">
                    <h3>🎵 @T("MomentOfCalm")</h3>
                    <p>@_plan.CalmingRecommendation</p>
                </div>

                <div class="plan-card week-note">
                    <h3>📝 @T("ForYou")</h3>
                    <p>@_plan.CaregiverNote</p>
                </div>

                <button class="bloom-btn secondary checkin-again-btn" @onclick="() => _plan = null">
                    @T("CheckInAgain")
                </button>
            }
        </div>
    }
</div>

@code {
    private List<ElderProfile> _elders = [];
    private ElderProfile? _selectedElder;
    private VitalsReading? _recentVitals;
    private bool _addingElder;
    private string _newName = string.Empty;
    private int _newAge = 70;
    private string _newRelation = string.Empty;
    private string? _newMedicalNotes;
    private string _doctorNameInput = string.Empty;
    private string _doctorEmailInput = string.Empty;
    private bool _doctorSaved;

    private int? _vitalsSystolic;
    private int? _vitalsDiastolic;
    private int? _vitalsHeartRate;
    private decimal? _vitalsTemperature;
    private int? _vitalsOxygen;
    private Alert? _activeAlert;
    private bool _checkingVitals;
    private List<decimal> _systolicTrend = [];

    private string _moodDescription = string.Empty;
    private ElderDailyPlan? _plan;
    private bool _generating;
    private string? _error;
    private CancellationTokenSource? _cts;

    private int _currentUserId;
    private List<ShareInfo> _shares = [];
    private string _shareUsernameInput = string.Empty;
    private string? _shareError;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await CurrentUser.GetUserIdAsync();
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();
        await LoadEldersAsync();
    }

    private async Task LoadEldersAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var accessibleIds = await CareAccess.GetAccessibleElderIdsAsync(userId);
        _elders = await Db.ElderProfiles.AsNoTracking()
            .Where(e => accessibleIds.Contains(e.Id))
            .OrderBy(e => e.Name)
            .ToListAsync();
    }

    private async Task SaveElderAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;

        Db.ElderProfiles.Add(new ElderProfile
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Name = _newName.Trim(),
            Age = _newAge,
            Relation = string.IsNullOrWhiteSpace(_newRelation) ? T("FamilyMemberDefault") : _newRelation.Trim(),
            MedicalNotes = string.IsNullOrWhiteSpace(_newMedicalNotes) ? null : _newMedicalNotes.Trim()
        });
        await Db.SaveChangesAsync();

        _newName = string.Empty;
        _newAge = 70;
        _newRelation = string.Empty;
        _newMedicalNotes = null;
        _addingElder = false;
        await LoadEldersAsync();
    }

    private async Task SelectElderAsync(ElderProfile elder)
    {
        _selectedElder = elder;
        _plan = null;
        _moodDescription = string.Empty;
        _doctorNameInput = elder.DoctorName ?? string.Empty;
        _doctorEmailInput = elder.DoctorEmail ?? string.Empty;
        _doctorSaved = false;
        _recentVitals = await Db.VitalsReadings.AsNoTracking()
            .Where(v => v.ElderProfileId == elder.Id)
            .OrderByDescending(v => v.RecordedAt)
            .FirstOrDefaultAsync();
        _activeAlert = await Db.Alerts.AsNoTracking()
            .Where(a => a.ElderProfileId == elder.Id && !a.Acknowledged)
            .OrderByDescending(a => a.TriggeredAt)
            .FirstOrDefaultAsync();
        await LoadSystolicTrendAsync();

        _shareUsernameInput = string.Empty;
        _shareError = null;
        _shares = elder.UserId == _currentUserId
            ? await CareAccess.GetSharesForElderAsync(elder.Id)
            : [];
    }

    private async Task ShareElderAsync()
    {
        if (_selectedElder == null || string.IsNullOrWhiteSpace(_shareUsernameInput)) return;
        _shareError = await CareAccess.GrantElderAccessAsync(_selectedElder.Id, _shareUsernameInput, _currentUserId);
        if (_shareError == null)
        {
            _shareUsernameInput = string.Empty;
            _shares = await CareAccess.GetSharesForElderAsync(_selectedElder.Id);
        }
    }

    private async Task RevokeShareAsync(int shareId)
    {
        if (_selectedElder == null) return;
        await CareAccess.RevokeAsync(shareId, _currentUserId);
        _shares = await CareAccess.GetSharesForElderAsync(_selectedElder.Id);
    }

    private async Task LoadSystolicTrendAsync()
    {
        if (_selectedElder == null) return;
        var recent = await Db.VitalsReadings.AsNoTracking()
            .Where(v => v.ElderProfileId == _selectedElder.Id && v.SystolicBp != null)
            .OrderByDescending(v => v.RecordedAt)
            .Take(10)
            .Select(v => v.SystolicBp!.Value)
            .ToListAsync();
        recent.Reverse(); // oldest first, so the chart reads left-to-right chronologically
        _systolicTrend = recent.Select(v => (decimal)v).ToList();
    }

    private async Task SaveDoctorContactAsync()
    {
        if (_selectedElder == null) return;
        var name = string.IsNullOrWhiteSpace(_doctorNameInput) ? null : _doctorNameInput.Trim();
        var email = string.IsNullOrWhiteSpace(_doctorEmailInput) ? null : _doctorEmailInput.Trim();

        await Db.ElderProfiles.Where(e => e.Id == _selectedElder.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(e => e.DoctorName, name)
                .SetProperty(e => e.DoctorEmail, email));

        _selectedElder.DoctorName = name;
        _selectedElder.DoctorEmail = email;
        _doctorSaved = true;
    }

    private async Task SaveVitalsAsync()
    {
        if (_selectedElder == null) return;

        var reading = new VitalsReading
        {
            ElderProfileId = _selectedElder.Id,
            SystolicBp = _vitalsSystolic,
            DiastolicBp = _vitalsDiastolic,
            HeartRate = _vitalsHeartRate,
            TemperatureC = _vitalsTemperature,
            OxygenSaturation = _vitalsOxygen
        };

        _vitalsSystolic = null;
        _vitalsDiastolic = null;
        _vitalsHeartRate = null;
        _vitalsTemperature = null;
        _vitalsOxygen = null;

        await ProcessVitalsReadingAsync(reading);
    }

    // Stands in for a real device-cloud sync (Withings, Omron, etc.) until
    // one is actually wired up — generates a plausible reading exactly the
    // shape a real BP cuff would report, and runs it through the identical
    // pipeline a manual entry does (threshold check, alert, push/email),
    // so the "device already reported something concerning" story is
    // demoable today without vendor API access or owning hardware.
    private static readonly Random _deviceRandom = new();

    private async Task SimulateDeviceSyncAsync()
    {
        if (_selectedElder == null) return;

        // Weighted toward normal readings, occasionally abnormal — mirrors
        // how a real device intermittently catches a genuine concern rather
        // than every reading being dramatic.
        var abnormal = _deviceRandom.NextDouble() < 0.25;
        var reading = new VitalsReading
        {
            ElderProfileId = _selectedElder.Id,
            SystolicBp = abnormal ? _deviceRandom.Next(182, 205) : _deviceRandom.Next(105, 135),
            DiastolicBp = _deviceRandom.Next(65, 90),
            HeartRate = _deviceRandom.Next(62, 95),
            TemperatureC = 36.5m + (decimal)(_deviceRandom.NextDouble() * 0.8 - 0.2),
            OxygenSaturation = abnormal && _deviceRandom.NextDouble() < 0.4 ? _deviceRandom.Next(86, 91) : _deviceRandom.Next(94, 99),
            Source = "Withings BPM Connect (simulated)"
        };

        await ProcessVitalsReadingAsync(reading);
    }

    private async Task ProcessVitalsReadingAsync(VitalsReading reading)
    {
        if (_selectedElder == null) return;

        // Pre-check locally purely to decide whether to show the spinner
        // while the real (authoritative) check runs inside VitalsIngestService
        // -- VitalsThresholdChecker.Check is pure/cheap, so checking twice
        // costs nothing and keeps this page's UI logic simple.
        var willConcern = VitalsThresholdChecker.Check(reading).Count > 0;
        if (willConcern)
        {
            _checkingVitals = true;
            StateHasChanged();
        }

        var language = (await ProfileCache.GetAsync())?.Language ?? AppLanguage.English;
        var result = await VitalsIngest.IngestAsync(_selectedElder, reading, language);

        await LoadSystolicTrendAsync();
        _recentVitals = reading;
        if (result.AlertRaised)
        {
            _activeAlert = result.Alert;
        }
        _checkingVitals = false;
    }

    private async Task AcknowledgeAlertAsync()
    {
        if (_activeAlert == null) return;
        var alert = await Db.Alerts.FindAsync(_activeAlert.Id);
        if (alert != null)
        {
            alert.Acknowledged = true;
            await Db.SaveChangesAsync();
        }
        _activeAlert = null;
    }

    private async Task GeneratePlanAsync()
    {
        if (_selectedElder == null || string.IsNullOrWhiteSpace(_moodDescription)) return;
        _generating = true;
        _error = null;
        StateHasChanged();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var vitalsSummary = _recentVitals != null ? BuildVitalsSummary(_recentVitals) : null;
            var language = (await ProfileCache.GetAsync())?.Language ?? AppLanguage.English;
            _plan = await Agents.ElderNurture.GenerateDailyPlanAsync(
                _selectedElder, _moodDescription, vitalsSummary, null, language, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _error = T("GenericRetryError");
        }

        _generating = false;
    }

    private string BuildVitalsSummary(VitalsReading v)
    {
        var parts = new List<string>();
        if (v.SystolicBp.HasValue && v.DiastolicBp.HasValue) parts.Add($"BP {v.SystolicBp}/{v.DiastolicBp}");
        if (v.HeartRate.HasValue) parts.Add($"HR {v.HeartRate} bpm");
        if (v.TemperatureC.HasValue) parts.Add($"Temp {v.TemperatureC}°C");
        if (v.OxygenSaturation.HasValue) parts.Add($"O2 {v.OxygenSaturation}%");
        return parts.Count > 0 ? string.Join(", ", parts) : T("NoReadingsLogged");
    }

    private string FormatAgo(DateTime recordedAt)
    {
        var span = DateTime.UtcNow - recordedAt;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}{T("MinAgo")}";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}{T("HourAgo")}";
        return $"{(int)span.TotalDays}{T("DayAgo")}";
    }

    public void Dispose() => _cts?.Cancel();

    private static readonly Dictionary<string, Dictionary<string, string>> Strings = new()
    {
        ["English"] = new()
