@page "/breathe"
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@rendermode InteractiveServer

<PageTitle>Janani — Breathing Corner</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="breathe"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    <div class="breathe-card">
        <div class="pattern-selector">
            @foreach (var pattern in _patterns)
            {
                <button class="pattern-btn @(_selectedPattern.Key == pattern.Key ? "selected" : "")"
                        @onclick="() => SelectPattern(pattern)">
                    @pattern.Emoji @T($"Pattern_{pattern.Key}_Name")
                </button>
            }
        </div>

        <p class="pattern-desc">@T($"Pattern_{_selectedPattern.Key}_Desc")</p>

        @if (!_running)
        {
            <button class="bloom-btn primary start-breathe-btn" @onclick="StartAsync">
                @T("BeginButton")
            </button>
        }
        else
        {
            <div class="breathe-circle-wrap">
                <div class="breathe-circle @_phase.ToLower().Replace(" ", "-")"
                     style="animation-duration: @(_phaseDuration)s">
                </div>
                <div class="breathe-label">
                    <span class="phase-text">@PhaseDisplay(_phase)</span>
                    <span class="phase-count" @key="_countdown">@_countdown</span>
                </div>
            </div>

            <p class="cycle-count">@string.Format(T("CycleFormat"), _cycle, _totalCycles)</p>

            <button class="bloom-btn secondary" @onclick="Stop">
                @T("StopButton")
            </button>
        }

        @if (_done)
        {
            <div class="breathe-done">
                <p>@T("DoneMessage")</p>
                <p>@T("DoneSubtext")</p>
            </div>
        }
    </div>

    <div class="breathe-tips">
        <h3>@T("TipsTitle")</h3>
        <ul class="tips-list">
            <li>@T("Tip1")</li>
            <li>@T("Tip2")</li>
            <li>@T("Tip3")</li>
            <li>@T("Tip4")</li>
            <li>@T("Tip5")</li>
        </ul>
    </div>
</div>

@code {
    private record BreathingPattern(string Key, string Emoji,
        int InhaleSeconds, int HoldInSeconds, int ExhaleSeconds, int HoldOutSeconds, int Cycles);

    private readonly BreathingPattern[] _patterns =
    [
        new("478", "🌙", 4, 7, 8, 0, 4),
        new("box", "🟦", 4, 4, 4, 4, 4),
        new("waves", "🌊", 5, 0, 5, 0, 6),
    ];

    private BreathingPattern _selectedPattern;
    private bool _running, _done;
    private string _phase = "Breathe in";
    private int _countdown, _cycle, _totalCycles;
    private double _phaseDuration = 4;
    private CancellationTokenSource? _cts;
    private string _language = "English";

    public Breathe() => _selectedPattern = _patterns[2]; // default: gentle waves

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();
    }

    private void SelectPattern(BreathingPattern p)
    {
        if (_running) Stop();
        _selectedPattern = p;
        _done = false;
    }

    private async Task StartAsync()
    {
        _cts = new CancellationTokenSource();
        _running = true;
        _done = false;
        _cycle = 0;
        _totalCycles = _selectedPattern.Cycles;

        try
        {
            while (_cycle < _totalCycles && !_cts.Token.IsCancellationRequested)
            {
                _cycle++;
                await RunPhase("Breathe in", _selectedPattern.InhaleSeconds, _cts.Token);
                if (_selectedPattern.HoldInSeconds > 0)
                    await RunPhase("Hold", _selectedPattern.HoldInSeconds, _cts.Token);
                await RunPhase("Breathe out", _selectedPattern.ExhaleSeconds, _cts.Token);
                if (_selectedPattern.HoldOutSeconds > 0)
                    await RunPhase("Hold", _selectedPattern.HoldOutSeconds, _cts.Token);
            }
        }
        catch (OperationCanceledException) { }

        _running = false;
        _done = !_cts.IsCancellationRequested;
        StateHasChanged();
    }

    private async Task RunPhase(string phase, int seconds, CancellationToken ct)
    {
        _phase = phase;
        _phaseDuration = seconds;
        for (_countdown = seconds; _countdown > 0; _countdown--)
        {
            StateHasChanged();
            await Task.Delay(1000, ct);
        }
    }

    private void Stop()
    {
        _cts?.Cancel();
        _running = false;
        _done = false;
    }

    // _phase drives the CSS animation class (see breathe-circle above) so it
    // stays an internal English key; this maps it to display text only.
    private string PhaseDisplay(string phase) => phase switch
    {
        "Breathe in" => T("PhaseIn"),
        "Hold" => T("PhaseHold"),
        "Breathe out" => T("PhaseOut"),
        _ => phase
    };

