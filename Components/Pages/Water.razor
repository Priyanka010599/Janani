@page "/water"
@using Janani.Models
@using Janani.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@rendermode InteractiveServer

<PageTitle>Janani — Water & Wellness</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="water"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    <div class="water-card @(_todayGlasses >= 8 ? "goal-reached" : "")">

        @if (_todayGlasses >= 8)
        {
            <div class="celebration">@T("Celebration")</div>
        }

        <!-- Progress ring -->
        <div class="progress-ring-wrap">
            <div class="progress-circle"
                 style="--pct: @(Math.Min(100, _todayGlasses * 12.5))">
                <div class="progress-inner">
                    <span class="progress-icon">@(_todayGlasses >= 8 ? "🌟" : "💧")</span>
                    <span class="count-big">@_todayGlasses</span>
                    <span class="count-label">@T("OfGlasses")</span>
                </div>
            </div>
        </div>

        <!-- Individual glass buttons with fill animation -->
        <div class="water-glasses">
            @for (int i = 1; i <= 8; i++)
            {
                var glassNum = i;
                <button class="glass-btn @(glassNum <= _todayGlasses ? "filled" : "empty")"
                        @onclick="() => SetGlasses(glassNum)"
                        title="@glassNum @(glassNum > 1 ? T("GlassPlural") : T("GlassSingular"))">
                    <div class="glass-fill"></div>
                    <span class="glass-icon">@(glassNum <= _todayGlasses ? "💧" : "🫙")</span>
                    <span class="glass-num">@glassNum</span>
                </button>
            }
        </div>

        <!-- Quick +/- buttons -->
        <div class="quick-actions">
            <button class="quick-btn minus"
                    @onclick="() => SetGlasses(Math.Max(0, _todayGlasses - 1))"
                    disabled="@(_todayGlasses == 0)">−</button>
            <button class="quick-btn plus" @onclick="() => SetGlasses(_todayGlasses + 1)"
                    disabled="@(_todayGlasses >= 8)">
                @T("AddGlassButton")
            </button>
        </div>

        <div class="water-message">
            <p>@GetGentleMessage()</p>
        </div>

        @if (_todayGlasses > 0)
        {
            <button class="bloom-btn secondary small-btn reset-btn"
                    @onclick="() => SetGlasses(0)">
                @T("ResetToday")
            </button>
        }
    </div>

    <div class="wellness-tips">
        <h3>@T("TipsTitle")</h3>
        <ul class="tips-list">
            <li>@T("Tip1")</li>
            <li>@T("Tip2")</li>
            <li>@T("Tip3")</li>
            <li>@T("Tip4")</li>
            <li>@T("Tip5")</li>
        </ul>
    </div>

    <div class="water-history">
        <h3>@T("ThisWeek")</h3>
        <div class="history-row">
            @foreach (var entry in _weekHistory)
            {
                var isToday = entry.Date == _today;
                <div class="history-day @(isToday ? "is-today" : "")">
                    <span class="history-date">@entry.Date.ToString("ddd")</span>
                    <div class="history-bar-wrap">
                        <div class="history-bar @(entry.GlassesCount >= 8 ? "hit-goal" : "")"
                             style="height: @(Math.Min(100, entry.GlassesCount * 12.5))%">
                        </div>
                    </div>
                    <span class="history-count">@entry.GlassesCount</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int _todayGlasses;
    private List<WaterIntakeEntry> _weekHistory = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();

        var todayEntry = await Db.WaterIntake.AsNoTracking().FirstOrDefaultAsync(w => w.Date == _today && w.UserId == userId);
        _todayGlasses = todayEntry?.GlassesCount ?? 0;
        await LoadWeekHistoryAsync();
    }

    private async Task LoadWeekHistoryAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var weekStart = _today.AddDays(-6);
        var dbEntries = await Db.WaterIntake.AsNoTracking().Where(w => w.Date >= weekStart && w.UserId == userId).ToListAsync();

        _weekHistory = Enumerable.Range(0, 7)
            .Select(i => _today.AddDays(i - 6))
            .Select(day => dbEntries.FirstOrDefault(w => w.Date == day)
                ?? new WaterIntakeEntry { Date = day, GlassesCount = 0 })
            .OrderBy(w => w.Date)
            .ToList();
    }

    private async Task SetGlasses(int count)
    {
        if (count < 0 || count > 8) return;
        _todayGlasses = count;

        var userId = await CurrentUser.GetUserIdAsync();
        var existing = await Db.WaterIntake.FirstOrDefaultAsync(w => w.Date == _today && w.UserId == userId);
        if (existing != null)
            existing.GlassesCount = count;
        else
            Db.WaterIntake.Add(new WaterIntakeEntry { Date = _today, GlassesCount = count, UserId = userId });

        await Db.SaveChangesAsync();

        var historyEntry = _weekHistory.FirstOrDefault(w => w.Date == _today);
        if (historyEntry != null) historyEntry.GlassesCount = count;
    }

