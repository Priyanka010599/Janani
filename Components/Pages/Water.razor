        1 => T("WaterMsg1"),
        2 or 3 => T("WaterMsg2"),
        4 => T("WaterMsg3"),
        5 or 6 => T("WaterMsg4"),
        7 => T("WaterMsg5"),
        >= 8 => T("WaterMsg6"),
