@page "/recovery-plan"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject UserProfileCache ProfileCache
@rendermode InteractiveServer

<PageTitle>Janani — Recovery Plan</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1>🌷 @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_postpartumDay == null)
    {
        <div class="empty-state">
            <p>@T("NotYetTitle")</p>
            <p>@T("NotYetHint")</p>
        </div>
    }
    else
    {
        <div class="plan-card urgent-card">
            <h3>🚩 @T("RedFlagsTitle")</h3>
            <p class="sos-hint">@T("RedFlagsHint")</p>
            <ul>
                @foreach (var flag in RecoveryPlanGenerator.RedFlags)
                {
                    <li>@flag.Text <span class="sos-hint">(@flag.SourceRef)</span></li>
                }
            </ul>
        </div>

        <div class="plan-card">
            <h3>🏠 @T("HbncTitle")</h3>
            <p class="sos-hint">@T("HbncHint")</p>
            <ul>
                @foreach (var visit in _hbncVisits)
                {
                    <li>
                        <button type="button" class="icon-btn @(visit.Status == HbncVisitStatus.Completed ? "is-done" : "")" title="@T("MarkDone")" aria-label="@T("MarkDone")"
                                @onclick="() => ToggleCompletionAsync(visit.Visit.Key)">
                            @(visit.Status == HbncVisitStatus.Completed ? "✓" : "○")
                        </button>
                        @string.Format(T("HbncDayLabel"), visit.Visit.Day)
                        <span class="sos-hint">— @HbncStatusLabel(visit.Status)</span>
                    </li>
                }
            </ul>
        </div>

        @foreach (var phase in _phases)
        {
            <div class="plan-card @(phase == _currentPhase ? "is-current-phase" : "")">
                <h3>@PhaseLabel(phase) @(phase == _currentPhase ? $"— {T("CurrentPhase")}" : "")</h3>
                @foreach (var categoryGroup in RecoveryPlanGenerator.GeneralContentForPhase(phase).GroupBy(i => i.Category))
                {
                    <h4>@CategoryLabel(categoryGroup.Key)</h4>
                    <ul>
                        @foreach (var item in categoryGroup)
                        {
                            <li>
                                <button type="button" class="icon-btn @(_completedKeys.Contains(item.Key) ? "is-done" : "")" title="@T("MarkDone")" aria-label="@T("MarkDone")"
                                        @onclick="() => ToggleCompletionAsync(item.Key)">
                                    @(_completedKeys.Contains(item.Key) ? "✓" : "○")
                                </button>
                                @item.Text
                                <span class="sos-hint">(@item.SourceRef)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="plan-card">
            <h3>🩺 @T("AskDoctorTitle")</h3>
            <p class="sos-hint">@T("AskDoctorHint")</p>
            @if (_doctorPrompts.Count == 0)
            {
                <p class="sos-hint">@T("NoPromptsYet")</p>
            }
            else
            {
                <ul>
                    @foreach (var prompt in _doctorPrompts)
                    {
                        <li>@prompt.Prompt <span class="sos-hint">(@prompt.SourceRef)</span></li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private int _userId;
    private string _language = "English";
    private int? _postpartumDay;
    private RecoveryPhase? _currentPhase;
    private readonly RecoveryPhase[] _phases =
    [
        RecoveryPhase.Days0to2, RecoveryPhase.Days3to7, RecoveryPhase.Days8to42, RecoveryPhase.Day43Plus
    ];
    private List<AskYourDoctorPrompt> _doctorPrompts = [];
    private HashSet<string> _completedKeys = [];
    private List<HbncVisitSchedule.VisitWithStatus> _hbncVisits = [];

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetUserIdAsync();
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();
        _postpartumDay = profile?.PostpartumDay;

        if (_postpartumDay == null) return;

        _currentPhase = RecoveryPlanGenerator.PhaseForDay(_postpartumDay);
        _doctorPrompts = RecoveryPlanGenerator.DoctorPromptsFor(
            profile!.DeliveryType, profile.DeliveryComplications, profile.CareContext).ToList();

        var completions = await Db.RecoveryPlanItemCompletions.AsNoTracking()
            .Where(c => c.UserId == _userId)
            .Select(c => new { c.ItemKey, c.CompletedAt })
            .ToListAsync();
        _completedKeys = completions.Select(c => c.ItemKey).ToHashSet();

        // HBNC visit completion is recorded through this exact same
        // RecoveryPlanItemCompletion table, keyed by HbncVisitSchedule's
        // own "hbnc-dayN" keys -- no separate visit table.
        var completedAtByKey = completions.ToDictionary(c => c.ItemKey, c => c.CompletedAt);
        _hbncVisits = HbncVisitSchedule.BuildStatus(_postpartumDay, completedAtByKey);
    }

    private async Task ToggleCompletionAsync(string itemKey)
    {
        if (_completedKeys.Contains(itemKey))
        {
            var existing = await Db.RecoveryPlanItemCompletions
                .FirstOrDefaultAsync(c => c.UserId == _userId && c.ItemKey == itemKey);
            if (existing != null)
            {
                Db.RecoveryPlanItemCompletions.Remove(existing);
                await Db.SaveChangesAsync();
            }
            _completedKeys.Remove(itemKey);
        }
        else
        {
            Db.RecoveryPlanItemCompletions.Add(new RecoveryPlanItemCompletion { UserId = _userId, ItemKey = itemKey });
            await Db.SaveChangesAsync();
            _completedKeys.Add(itemKey);
        }

        // Refresh HBNC status too -- itemKey may be one of its "hbnc-dayN"
        // keys, and its displayed status (and CompletedAt) needs to
        // reflect the toggle immediately, not just after a reload.
        var completedAtByKey = (await Db.RecoveryPlanItemCompletions.AsNoTracking()
            .Where(c => c.UserId == _userId)
            .Select(c => new { c.ItemKey, c.CompletedAt })
            .ToListAsync()).ToDictionary(c => c.ItemKey, c => c.CompletedAt);
        _hbncVisits = HbncVisitSchedule.BuildStatus(_postpartumDay, completedAtByKey);
    }

    private string HbncStatusLabel(HbncVisitStatus status) => status switch
    {
        HbncVisitStatus.Completed => T("HbncCompleted"),
        HbncVisitStatus.Overdue => T("HbncOverdue"),
        HbncVisitStatus.DueNow => T("HbncDueNow"),
        _ => T("HbncUpcoming")
    };

    private string PhaseLabel(RecoveryPhase phase) => phase switch
    {
        RecoveryPhase.Days0to2 => T("PhaseDays0to2"),
        RecoveryPhase.Days3to7 => T("PhaseDays3to7"),
        RecoveryPhase.Days8to42 => T("PhaseDays8to42"),
        _ => T("PhaseDay43Plus")
    };

    private string CategoryLabel(RecoveryCategory category) => category switch
    {
        RecoveryCategory.WoundCare => T("CategoryWoundCare"),
        RecoveryCategory.Pain => T("CategoryPain"),
        RecoveryCategory.MobilityExercise => T("CategoryMobilityExercise"),
        RecoveryCategory.Bleeding => T("CategoryBleeding"),
        RecoveryCategory.BladderBowel => T("CategoryBladderBowel"),
        RecoveryCategory.NutritionSleep => T("CategoryNutritionSleep"),
        RecoveryCategory.MentalHealth => T("CategoryMentalHealth"),
        _ => category.ToString()
    };

