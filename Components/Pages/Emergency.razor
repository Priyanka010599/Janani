@page "/emergency"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject UserProfileCache ProfileCache
@inject CurrentUserService CurrentUser
@inject CareAccessService CareAccess
@inject IEmailNotificationService EmailNotifications
@rendermode InteractiveServer

<PageTitle>Janani — Distress & Support</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="sos"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    <div class="sos-safety-note">
        <p>⚠️ @T("SafetyNote")</p>
    </div>

    @if (_subjects.Count > 1)
    {
        <div class="sos-card">
            <h3>@T("WhoIsThisAbout")</h3>
            <div class="feeling-grid">
                @foreach (var subject in _subjects)
                {
                    <button class="feeling-btn @(_selectedSubjectKey == subject.Key ? "selected" : "")" @onclick="() => SelectSubjectAsync(subject.Key)">
                        <span>@subject.Icon</span>
                        <span class="feeling-label">@subject.Label</span>
                    </button>
                }
            </div>
        </div>
    }

    <div class="sos-card">
        <h3>💗 @T("SendMessageTitle")</h3>
        <p class="sos-hint">@T("SendMessageHint")</p>
        <textarea class="sos-message" @bind="_sosMessage" @bind:event="oninput" rows="3"></textarea>
    </div>

    @if (_sendError is not null)
    {
        <div class="sos-safety-note">
            <p>⚠️ @_sendError</p>
        </div>
    }

    @if (_contacts.Any())
    {
        <div class="contact-list">
            @{ var contactIndex = 0; }
            @foreach (var c in _contacts)
            {
                var cIdx = contactIndex++;
                <div class="contact-card @(c.IsDoctor ? "is-doctor" : "")" style="animation-delay: @(cIdx * 0.05)s">
                    <div class="contact-info">
                        <strong>@c.Name</strong>
                        <span class="contact-relation">@(c.IsDoctor ? "🩺 " : "💗 ")@c.Relation</span>
                    </div>
                    <div class="contact-actions">
                        @if (!string.IsNullOrWhiteSpace(c.Phone))
                        {
                            <a class="bloom-btn primary small-btn" href="@($"tel:{c.Phone}")">📞 @T("CallBtn")</a>
                            <a class="bloom-btn secondary small-btn" href="@BuildSmsLink(c.Phone)">💬 @T("TextBtn")</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Email))
                        {
                            @* Sends server-side rather than opening a mailto: —
                               a mail-client picker dialog is the wrong thing to
                               meet someone with when they've just tapped SOS. *@
                            <button class="bloom-btn secondary small-btn"
                                    @onclick="() => SendEmailAsync(c)"
                                    disabled="@(_sendingTo == c.Id || _sentTo.Contains(c.Id))">
                                @if (_sendingTo == c.Id)
                                {
                                    @($"⏳ {T("EmailSending")}")
                                }
                                else if (_sentTo.Contains(c.Id))
                                {
                                    @($"✅ {T("EmailSent")}")
                                }
                                else
                                {
                                    @($"✉️ {T("EmailBtn")}")
                                }
                            </button>
                        }
                        <button class="icon-btn" title="@string.Format(T("RemoveTemplate"), c.Name)" aria-label="@string.Format(T("RemoveTemplate"), c.Name)" @onclick="() => DeleteContactAsync(c)">✕</button>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_adding)
    {
        <div class="empty-state">
            <p>@T("EmptyTitle")</p>
            <p>@T("EmptyHint")</p>
        </div>
    }

    @if (_adding)
    {
        <div class="appointment-form">
            <h3>@T("AddSomeoneHeading")</h3>
            <div class="form-field">
                <label>@T("NameLabel")</label>
                <input @bind="_newName" placeholder="@T("NamePlaceholder")" />
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label>@T("RelationLabel")</label>
                    <input @bind="_newRelation" placeholder="@T("RelationPlaceholder")" />
                </div>
                <div class="form-field">
                    <label class="checkbox-field">
                        <input type="checkbox" @bind="_newIsDoctor" /> @T("IsDoctorLabel")
                    </label>
                </div>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label>@T("PhoneLabel")</label>
                    <input @bind="_newPhone" placeholder="+1 555 123 4567" />
                </div>
                <div class="form-field">
                    <label>@T("EmailLabel")</label>
                    <input @bind="_newEmail" placeholder="name@example.com" />
                </div>
            </div>
            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveContactAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">
                    @T("SaveContactBtn")
                </button>
                <button class="bloom-btn secondary" @onclick="() => _adding = false">@T("Cancel")</button>
            </div>
        </div>
    }
    else
    {
        <button class="bloom-btn secondary new-entry-btn" @onclick="() => _adding = true">
            @T("AddContactBtn")
        </button>
    }
</div>

@code {
    private record SosSubject(string Key, string Icon, string Label);

    [SupplyParameterFromQuery(Name = "about")]
    private string? AboutParam { get; set; }

    private List<EmergencyContact> _contacts = [];
    private List<ElderProfile> _elders = [];
    private List<InfantProfile> _infants = [];
    private Dictionary<int, Alert> _openElderAlerts = [];
    private Dictionary<int, InfantAlert> _openInfantAlerts = [];
    private List<SosSubject> _subjects = [];
    private string _selectedSubjectKey = "self";
    private UserProfile? _profile;
    private bool _adding;
    private string _newName = string.Empty;
    private string _newRelation = string.Empty;
    private string _newPhone = string.Empty;
    private string _newEmail = string.Empty;
    private bool _newIsDoctor;
    private string _sosMessage = string.Empty;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileCache.GetAsync();
        _language = (_profile?.Language ?? AppLanguage.English).ToString();
        var userId = await CurrentUser.GetUserIdAsync();

        var accessibleElderIds = await CareAccess.GetAccessibleElderIdsAsync(userId);
        var accessibleInfantIds = await CareAccess.GetAccessibleInfantIdsAsync(userId);
        _elders = await Db.ElderProfiles.AsNoTracking()
            .Where(e => accessibleElderIds.Contains(e.Id))
            .OrderBy(e => e.Name)
            .ToListAsync();
        _infants = await Db.InfantProfiles.AsNoTracking()
            .Where(i => accessibleInfantIds.Contains(i.Id))
            .OrderBy(i => i.Name)
            .ToListAsync();

        if (_elders.Count > 0)
        {
            var elderIds = _elders.Select(e => e.Id).ToList();
            var openAlerts = await Db.Alerts.AsNoTracking()
                .Where(a => elderIds.Contains(a.ElderProfileId) && !a.Acknowledged)
                .OrderByDescending(a => a.TriggeredAt)
                .ToListAsync();
            _openElderAlerts = openAlerts
                .GroupBy(a => a.ElderProfileId)
                .ToDictionary(g => g.Key, g => g.First());
        }

        if (_infants.Count > 0)
        {
            var infantIds = _infants.Select(i => i.Id).ToList();
            var openAlerts = await Db.InfantAlerts.AsNoTracking()
                .Where(a => infantIds.Contains(a.InfantProfileId) && !a.Acknowledged)
                .OrderByDescending(a => a.TriggeredAt)
                .ToListAsync();
            _openInfantAlerts = openAlerts
                .GroupBy(a => a.InfantProfileId)
                .ToDictionary(g => g.Key, g => g.First());
        }

        _subjects = BuildSubjects();

        var initialKey = ResolveInitialSubjectKey();
        await SelectSubjectAsync(initialKey);

        await LoadContactsAsync();
    }

    private List<SosSubject> BuildSubjects()
    {
        var subjects = new List<SosSubject>();
        if (_profile?.TracksPregnancy != false)
        {
            subjects.Add(new SosSubject("self", "💗", T("Myself")));
        }
        subjects.AddRange(_elders.Select(e => new SosSubject($"elder-{e.Id}",
            _openElderAlerts.ContainsKey(e.Id) ? "🚨" : "🌼", e.Name)));
        subjects.AddRange(_infants.Select(i => new SosSubject($"infant-{i.Id}",
            _openInfantAlerts.ContainsKey(i.Id) ? "🚨" : "👶", i.Name)));

        if (subjects.Count == 0)
        {
            subjects.Add(new SosSubject("self", "💗", T("Myself")));
        }

        return subjects;
    }

    private string ResolveInitialSubjectKey()
    {
        if (!string.IsNullOrWhiteSpace(AboutParam) && _subjects.Any(s => s.Key == AboutParam))
            return AboutParam;

        return _subjects[0].Key;
    }

    private Task SelectSubjectAsync(string key)
    {
        _selectedSubjectKey = key;
        _sosMessage = BuildMessageForSubject(key);
        return Task.CompletedTask;
    }

    private string BuildMessageForSubject(string key)
    {
        var myName = _profile?.Name ?? "me";

        if (key.StartsWith("elder-") && int.TryParse(key["elder-".Length..], out var elderId))
        {
            var elder = _elders.FirstOrDefault(e => e.Id == elderId);
            if (elder != null)
            {
                var concern = _openElderAlerts.TryGetValue(elderId, out var alert)
                    ? alert.Message
                    : T("ConcernElderDefault");
                return string.Format(T("ElderMessageTemplate"), myName, elder.Name, elder.Relation, concern);
            }
        }

        if (key.StartsWith("infant-") && int.TryParse(key["infant-".Length..], out var infantId))
        {
            var infant = _infants.FirstOrDefault(i => i.Id == infantId);
            if (infant != null)
            {
                var concern = _openInfantAlerts.TryGetValue(infantId, out var alert)
                    ? alert.Message
                    : T("ConcernInfantDefault");
                return string.Format(T("InfantMessageTemplate"), myName, infant.Name, concern);
            }
        }

        if (_profile?.TracksPregnancy == true)
        {
            var weekText = _profile != null ? $"{_profile.CurrentWeek} {T("Weeks")}" : T("SomeWeeks");
            return string.Format(T("PregnancyMessageTemplate"), myName, weekText);
        }

        return string.Format(T("GenericMessageTemplate"), myName);
    }

    private async Task LoadContactsAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        _contacts = await Db.EmergencyContacts
            .AsNoTracking()
            .Where(c => c.UserId == userId)
            .OrderByDescending(c => c.IsDoctor)
            .ThenBy(c => c.Name)
            .ToListAsync();
    }

    private async Task SaveContactAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;

        Db.EmergencyContacts.Add(new EmergencyContact
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Name = _newName.Trim(),
            Relation = string.IsNullOrWhiteSpace(_newRelation) ? (_newIsDoctor ? T("DoctorDefault") : T("TrustedContactDefault")) : _newRelation.Trim(),
            Phone = string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone.Trim(),
            Email = string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail.Trim(),
            IsDoctor = _newIsDoctor
        });
        await Db.SaveChangesAsync();

        _newName = string.Empty;
        _newRelation = string.Empty;
        _newPhone = string.Empty;
        _newEmail = string.Empty;
        _newIsDoctor = false;
        _adding = false;
        await LoadContactsAsync();
    }

    private async Task DeleteContactAsync(EmergencyContact contact)
    {
        Db.EmergencyContacts.Remove(contact);
        await Db.SaveChangesAsync();
        await LoadContactsAsync();
    }

    private string BuildSmsLink(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        return $"sms:{Uri.EscapeDataString(phone)}?body={Uri.EscapeDataString(_sosMessage)}";
    }

    // Which contact's send is in flight, and which have already gone out this
    // visit. Tracked per contact id rather than as one page-level flag so
    // emailing two people in a row doesn't make the first button lie.
    private int? _sendingTo;
    private readonly HashSet<int> _sentTo = [];
    private string? _sendError;

    private async Task SendEmailAsync(EmergencyContact contact)
    {
        if (string.IsNullOrWhiteSpace(contact.Email) || _sendingTo is not null) return;

        _sendingTo = contact.Id;
        _sendError = null;

        var sent = await EmailNotifications.SendDoctorAlertAsync(
            contact.Email, contact.Name, T("EmailSubject"), _sosMessage);

        _sendingTo = null;
        if (sent)
        {
            _sentTo.Add(contact.Id);
        }
        else
        {
            // Never silently swallow this. She believes she has reached
            // someone; if she hasn't, she needs to know immediately so she can
            // call instead — the Call button is right there.
            _sendError = string.Format(T("EmailFailed"), contact.Name);
        }
    }

