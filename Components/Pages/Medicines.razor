@page "/medicine"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IJSRuntime JS
@inject CurrentUserService CurrentUser
@inject BloomAgentRegistry Agents
@rendermode InteractiveServer

<PageTitle>Janani — Medicine & Vitamins</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1>💊 @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_medicines.Any())
    {
        <div class="reminder-card">
            <div class="reminder-summary">
                <span class="reminder-count">@TakenCount<span class="reminder-total">/@TotalCount</span></span>
                <span class="reminder-count-label">@T("DosesTakenToday")</span>
            </div>
            <button class="bloom-btn primary" @onclick="EnableRemindersAsync">
                @("🔔 " + (_remindersEnabled ? T("RefreshReminders") : T("EnableReminders")))
            </button>
            @if (_reminderStatus == "denied")
            {
                <p class="reminder-note">@T("RemindersBlocked")</p>
            }
            else if (_reminderStatus == "unsupported")
            {
                <p class="reminder-note">@T("RemindersUnsupported")</p>
            }
            else if (_remindersEnabled)
            {
                <p class="reminder-note">@T("RemindersEnabledNote")</p>
            }
        </div>

        <div class="medicine-list">
            @{ var medIndex = 0; }
            @foreach (var med in _medicines)
            {
                var mIdx = medIndex++;
                <div class="medicine-card" style="animation-delay: @(mIdx * 0.05)s">
                    <div class="medicine-header">
                        <div>
                            <strong>@med.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(med.Dosage))
                            {
                                <span class="medicine-dosage">@med.Dosage</span>
                            }
                        </div>
                        <button class="icon-btn" title="@(T("Remove") + " " + med.Name)" aria-label="@(T("Remove") + " " + med.Name)" @onclick="() => DeleteMedicineAsync(med)">✕</button>
                    </div>
                    <div class="dose-row">
                        @foreach (var time in med.GetScheduleTimes())
                        {
                            var taken = IsTaken(med.Id, time);
                            var status = GetDoseStatus(time, taken);
                            <button class="dose-chip @status" @onclick="() => ToggleDoseAsync(med.Id, time)">
                                <span class="dose-time">@time.ToString("h:mm tt")</span>
                                <span class="dose-status">@(taken ? T("Taken") : status == "overdue" ? T("Overdue") : status == "due-soon" ? T("DueSoon") : T("UpcomingDose"))</span>
                            </button>
                        }
                    </div>
                    <div class="medicine-lookup">
                        @{ _lookupState.TryGetValue(med.Id, out var lookup); }
                        @if (lookup?.Explanation != null)
                        {
                            <p class="medicine-explanation">@lookup.Explanation</p>
                            <p class="data-source-note">@T("GroundedNote")</p>
                        }
                        else if (lookup?.Error != null)
                        {
                            <p class="medicine-explanation medicine-explanation-error">@lookup.Error</p>
                        }
                        else
                        {
                            <button class="bloom-btn secondary small-btn" @onclick="() => LookupMedicineAsync(med)" disabled="@(lookup?.IsLoading == true)">
                                @(lookup?.IsLoading == true ? T("LookingItUp") : T("WhatsThisFor"))
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (!_adding)
    {
        <div class="empty-state">
            <p>@T("EmptyStateTitle")</p>
            <p>@T("EmptyStateHint")</p>
        </div>
    }

    @if (_adding)
    {
        <div class="appointment-form">
            <h3>@T("AddMedicineHeading")</h3>
            <div class="form-field">
                <label>@T("NameLabel")</label>
                <input @bind="_newName" placeholder="@T("NamePlaceholder")" />
            </div>
            <div class="form-field">
                <label>@T("DosageLabel")</label>
                <input @bind="_newDosage" placeholder="@T("DosagePlaceholder")" />
            </div>
            <div class="form-field">
                <label>@T("ScheduleTimesLabel")</label>
                <div class="time-add-row">
                    <input type="time" @bind="_newTimeInput" />
                    <button class="bloom-btn secondary small-btn" type="button" @onclick="AddTime">+ @T("AddTimeButton")</button>
                </div>
                @if (_newTimes.Any())
                {
                    <div class="time-chip-row">
                        @foreach (var t in _newTimes)
                        {
                            <span class="time-chip">
                                @t.ToString("h:mm tt")
                                <button type="button" title="@T("RemoveTimeTitle")" @onclick="() => RemoveTime(t)">✕</button>
                            </span>
                        }
                    </div>
                }
            </div>
            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveMedicineAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_newName) || !_newTimes.Any())">
                    @T("SaveButton")
                </button>
                <button class="bloom-btn secondary" @onclick="CancelAdding">@T("Cancel")</button>
            </div>
        </div>
    }
    else
    {
        <button class="bloom-btn secondary new-entry-btn" @onclick="() => _adding = true">
            + @T("AddMedicineHeading")
        </button>
    }
</div>

@code {
    private List<Medicine> _medicines = [];
    private List<MedicineDose> _todayDoses = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private bool _adding;
    private string _newName = string.Empty;
    private string _newDosage = string.Empty;
    private TimeOnly? _newTimeInput;
    private List<TimeOnly> _newTimes = [];

    private bool _remindersEnabled;
    private string? _reminderStatus;
    private string _language = "English";

    private class LookupState
    {
        public bool IsLoading;
        public string? Explanation;
        public string? Error;
    }
    private readonly Dictionary<int, LookupState> _lookupState = [];

    private int TotalCount => _medicines.Sum(m => m.GetScheduleTimes().Count);
    private int TakenCount => _todayDoses.Count(d => d.Taken);

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        var profile = await Db.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == userId);
        _language = (profile?.Language ?? AppLanguage.English).ToString();

        await LoadMedicinesAsync();
        await LoadTodayDosesAsync();
    }

    private async Task LoadMedicinesAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        _medicines = await Db.Medicines.AsNoTracking()
            .Where(m => m.IsActive && m.UserId == userId)
            .OrderBy(m => m.Name)
            .ToListAsync();
    }

    private async Task LoadTodayDosesAsync()
    {
        // MedicineDose has no UserId of its own — ownership is transitive
        // through Medicine, so scope by the ids from the already-scoped
        // _medicines list rather than just filtering by date (which used to
        // return every user's doses for today).
        var medicineIds = _medicines.Select(m => m.Id).ToList();
        _todayDoses = await Db.MedicineDoses.AsNoTracking()
            .Where(d => d.Date == _today && medicineIds.Contains(d.MedicineId))
            .ToListAsync();
    }

    private bool IsTaken(int medicineId, TimeOnly time)
    {
        var timeStr = time.ToString("HH:mm");
        return _todayDoses.Any(d => d.MedicineId == medicineId && d.ScheduledTime == timeStr && d.Taken);
    }

    private string GetDoseStatus(TimeOnly time, bool taken)
    {
        if (taken) return "taken";
        var now = TimeOnly.FromDateTime(DateTime.Now);
        if (time <= now) return "overdue";
        if (time <= now.AddMinutes(30)) return "due-soon";
        return "upcoming";
    }

    private async Task ToggleDoseAsync(int medicineId, TimeOnly time)
    {
        var timeStr = time.ToString("HH:mm");
        var existing = await Db.MedicineDoses
            .FirstOrDefaultAsync(d => d.MedicineId == medicineId && d.Date == _today && d.ScheduledTime == timeStr);

        if (existing != null)
        {
            existing.Taken = !existing.Taken;
            // Npgsql rejects non-Utc DateTime.Kind for a timestamptz column
            // (see Appointments.razor's SaveAppointmentAsync for the same fix).
            existing.TakenAt = existing.Taken ? DateTime.UtcNow : null;
        }
        else
        {
            Db.MedicineDoses.Add(new MedicineDose
            {
                MedicineId = medicineId,
                Date = _today,
                ScheduledTime = timeStr,
                Taken = true,
                TakenAt = DateTime.UtcNow
            });
        }

        await Db.SaveChangesAsync();
        await LoadTodayDosesAsync();
    }

    private void RemoveTime(TimeOnly time) => _newTimes.Remove(time);

    private void AddTime()
    {
        if (_newTimeInput.HasValue && !_newTimes.Contains(_newTimeInput.Value))
        {
            _newTimes.Add(_newTimeInput.Value);
            _newTimes = _newTimes.OrderBy(t => t).ToList();
        }
        _newTimeInput = null;
    }

    private async Task SaveMedicineAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || !_newTimes.Any()) return;

        Db.Medicines.Add(new Medicine
        {
            UserId = await CurrentUser.GetUserIdAsync(),
            Name = _newName.Trim(),
            Dosage = string.IsNullOrWhiteSpace(_newDosage) ? null : _newDosage.Trim(),
            ScheduleTimes = string.Join(",", _newTimes.Select(t => t.ToString("HH:mm"))),
            IsActive = true
        });
        await Db.SaveChangesAsync();

        CancelAdding();
        await LoadMedicinesAsync();
    }

    private void CancelAdding()
    {
        _adding = false;
        _newName = string.Empty;
        _newDosage = string.Empty;
        _newTimeInput = null;
        _newTimes = [];
    }

    private async Task LookupMedicineAsync(Medicine med)
    {
        if (!_lookupState.TryGetValue(med.Id, out var state))
        {
            state = new LookupState();
            _lookupState[med.Id] = state;
        }
        if (state.IsLoading) return;

        state.IsLoading = true;
        StateHasChanged();

        try
        {
            state.Explanation = await Agents.MedicineLookup.LookupAsync(med.Name, med.Dosage);
        }
        catch (Exception)
        {
            state.Error = T("LookupError");
        }
        finally
        {
            state.IsLoading = false;
        }
    }

    private async Task DeleteMedicineAsync(Medicine medicine)
    {
        Db.Medicines.Remove(medicine);
        await Db.SaveChangesAsync();
        await LoadMedicinesAsync();
    }

    private async Task EnableRemindersAsync()
    {
        _reminderStatus = await JS.InvokeAsync<string>("bloomReminders.requestPermission");
        if (_reminderStatus != "granted")
        {
            _remindersEnabled = false;
            return;
        }

        await JS.InvokeVoidAsync("bloomReminders.clearAll");

        var now = DateTime.Now;
        foreach (var med in _medicines)
        {
            foreach (var time in med.GetScheduleTimes())
            {
                if (IsTaken(med.Id, time)) continue;

                var scheduled = _today.ToDateTime(time);
                if (scheduled <= now) continue;

                var body = string.IsNullOrWhiteSpace(med.Dosage)
                    ? T("DoseTimeBody")
                    : $"{med.Dosage} {T("DosageTimeSuffix")}";
                await JS.InvokeVoidAsync("bloomReminders.schedule", $"💊 {med.Name}", body, (scheduled - now).TotalMilliseconds);
            }
        }

        _remindersEnabled = true;
    }

