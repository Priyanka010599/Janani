@page "/family-care"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject BloomAgentRegistry Agents
@inject UserProfileCache ProfileCache
@inject CareAccessService CareAccess
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Janani — Family Care</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="family"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_snapshots.Count > 0)
    {
        <div class="contact-list">
            @foreach (var s in _snapshots)
            {
                <a class="contact-card @s.CardClass" href="@s.Link">
                    <div class="contact-info">
                        <strong>@s.Icon @s.Name</strong>
                        <span class="contact-relation">@s.Subtitle</span>
                    </div>
                    <span class="family-status @(s.HasAlert ? "alert" : "")">@s.Status</span>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>@T("EmptyTitle")</p>
            <p>@T("EmptyHint")</p>
        </div>
    }

    <div class="note-section">
        <label>@T("AskLabel")</label>
        <textarea @bind="_question" placeholder="@T("AskPlaceholder")" rows="2"></textarea>
    </div>

    <button class="bloom-btn primary" @onclick="AskAsync" disabled="@(string.IsNullOrWhiteSpace(_question) || _asking)">
        @if (_asking) { <span>@T("Thinking")</span> } else { <span>@T("Ask")</span> }
    </button>

    @if (_error != null)
    {
        <div class="meal-gentle-note error-note">
            <p>💗 @_error</p>
            <button class="bloom-btn secondary small-btn" @onclick="AskAsync">@T("TryAgain")</button>
        </div>
    }

    @if (_answer != null)
    {
        <div class="plan-card acknowledgment">
            <p>@_answer</p>
        </div>
    }
</div>

@code {
    private record FamilySnapshot(string Icon, string Name, string Subtitle, string Status, bool HasAlert, string CardClass, string Link);

    private List<FamilySnapshot> _snapshots = [];
    private string _question = string.Empty;
    private string? _answer;
    private bool _asking;
    private string? _error;
    private CancellationTokenSource? _cts;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileCache.GetAsync();
        _language = (profile?.Language ?? AppLanguage.English).ToString();
        var userId = await CurrentUser.GetUserIdAsync();
        var snapshots = new List<FamilySnapshot>();

        if (profile?.TracksPregnancy == true)
        {
            snapshots.Add(new FamilySnapshot("🌸", profile.Name, $"{profile.CurrentWeek} {T("WeeksPregnant")}",
                T("TrackToday"), false, "", "/"));
        }

        var accessibleElderIds = await CareAccess.GetAccessibleElderIdsAsync(userId);
        var elders = await Db.ElderProfiles.AsNoTracking()
            .Where(e => accessibleElderIds.Contains(e.Id))
            .OrderBy(e => e.Name)
            .ToListAsync();
        foreach (var elder in elders)
        {
            var alert = await Db.Alerts.AsNoTracking()
                .Where(a => a.ElderProfileId == elder.Id && !a.Acknowledged)
                .OrderByDescending(a => a.TriggeredAt)
                .FirstOrDefaultAsync();
            var lastVitals = await Db.VitalsReadings.AsNoTracking()
                .Where(v => v.ElderProfileId == elder.Id)
                .OrderByDescending(v => v.RecordedAt)
                .FirstOrDefaultAsync();

            var status = alert != null
                ? (alert.Severity == AlertSeverity.Critical ? T("NeedsAttention") : T("WorthChecking"))
                : lastVitals != null ? $"{T("VitalsLogged")} {FormatAgo(lastVitals.RecordedAt)}" : T("NoVitalsYet");
            var cardClass = alert == null ? "" : alert.Severity == AlertSeverity.Critical ? "is-alert-critical" : "is-alert-warning";

            snapshots.Add(new FamilySnapshot("🌼", elder.Name, elder.Relation, status, alert != null, cardClass, "/elder-care"));
        }

        var accessibleInfantIds = await CareAccess.GetAccessibleInfantIdsAsync(userId);
        var infants = await Db.InfantProfiles.AsNoTracking()
            .Where(i => accessibleInfantIds.Contains(i.Id))
            .OrderBy(i => i.Name)
            .ToListAsync();
        foreach (var infant in infants)
        {
            var lastFeeding = await Db.FeedingLogs.AsNoTracking()
                .Where(f => f.InfantProfileId == infant.Id)
                .OrderByDescending(f => f.FedAt)
                .FirstOrDefaultAsync();
            var given = await Db.VaccinationRecords.AsNoTracking()
                .Where(v => v.InfantProfileId == infant.Id)
                .ToListAsync();
            var overdueCount = VaccinationSchedule.BuildStatus(infant.AgeInWeeks, given)
                .Count(v => v.Status == VaccinationStatus.Overdue);
            var growthAlert = await Db.InfantAlerts.AsNoTracking()
                .Where(a => a.InfantProfileId == infant.Id && !a.Acknowledged)
                .OrderByDescending(a => a.TriggeredAt)
                .FirstOrDefaultAsync();

            var feedingStatus = lastFeeding != null ? $"{T("Fed")} {FormatAgo(lastFeeding.FedAt)}" : T("NoFeedingsYet");
            var status = growthAlert != null ? $"🚨 {growthAlert.Message}"
                : overdueCount > 0 ? $"🚨 {overdueCount} {T("VaccinesOverdue")}"
                : feedingStatus;
            var cardClass = growthAlert != null || overdueCount > 0 ? "is-alert-critical" : "";
            snapshots.Add(new FamilySnapshot("👶", infant.Name, $"{infant.AgeInWeeks} {T("WeeksOld")}", status, growthAlert != null || overdueCount > 0, cardClass, "/infant-care"));
        }

        _snapshots = snapshots;
    }

    private string FormatAgo(DateTime at)
    {
        var span = DateTime.UtcNow - at;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}{T("MinAgo")}";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}{T("HourAgo")}";
        return $"{(int)span.TotalDays}{T("DayAgo")}";
    }

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(_question)) return;
        _asking = true;
        _error = null;
        StateHasChanged();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var profile = await ProfileCache.GetAsync();
            _answer = await Agents.CaregiverCoordination.AskAsync(profile?.Name ?? "there", _question, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _error = T("GenericRetryError");
        }

        _asking = false;
    }

    public void Dispose() => _cts?.Cancel();

