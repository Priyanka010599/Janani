@page "/"
@attribute [AllowAnonymous]
@using Janani.Models
@using Janani.Services
@using Janani.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject BloomAgentRegistry Agents
@inject AppDbContext Db
@inject UserProfileCache ProfileCache
@inject CurrentUserService CurrentUser
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Janani — Family Care Companion</PageTitle>

@if (!_isAuthenticated)
{
    <div class="bloom-container landing-page">
        <div class="landing-hero">
            <h1>🌸 Janani</h1>
            <p class="landing-tagline">@T("Tagline")</p>
            <p class="subtitle">
                @T("LandingSubtitle")
            </p>
            <div class="form-actions">
                <a class="bloom-btn primary" href="/login">@T("LogInBtn")</a>
                <a class="bloom-btn secondary" href="/register">@T("CreateAccountBtn")</a>
            </div>
        </div>

        <div class="plan-card">
            <h3>🩺 @T("EngDecisionTitle")</h3>
            <p>
                @T("EngDecisionText")
            </p>
        </div>

        <div class="plan-card">
            <h3>🌷 @T("WhatsInsideTitle")</h3>
            <ul class="suggestion-list">
                <li>@T("WhatsInside1")</li>
                <li>@T("WhatsInside2")</li>
                <li>@T("WhatsInside3")</li>
                <li>@T("WhatsInside4")</li>
                <li>@T("WhatsInside5")</li>
                <li>@T("WhatsInside6")</li>
                <li>@T("WhatsInside7")</li>
            </ul>
        </div>
    </div>
}
else
{
<div class="bloom-container">
    @if (_profile != null && !_profile.TracksPregnancy)
    {
        <div class="section-header">
            <h1>@string.Format(T("WelcomeBack"), _profile.Name)</h1>
            <p class="subtitle">@T("CaregiverSubtitle")</p>
        </div>
        <div class="feeling-grid">
            @if (_profile.CaresForElder)
            {
                <a class="feeling-btn" href="/elder-care"><span>🌼</span><span class="feeling-label">@T("ElderCareLabel")</span></a>
            }
            @if (_profile.CaresForInfant)
            {
                <a class="feeling-btn" href="/infant-care"><span>👶</span><span class="feeling-label">@T("InfantCareLabel")</span></a>
            }
            <a class="feeling-btn" href="/family-care"><span>👨‍👩‍👧</span><span class="feeling-label">@T("FamilyCareLabel")</span></a>
        </div>
    }
    else if (!_planGenerated)
    {
        <div class="mood-checkin">
            <div class="greeting">
                <span class="week-badge">@string.Format(T("WeekBadge"), _profile?.CurrentWeek)</span>
                <h1>@string.Format(T("HowFeeling"), _profile?.Name ?? "Mama")</h1>
                <p class="subtitle">@T("NoWrongAnswer")</p>
            </div>

            <div class="mood-grid">
                @{ var moodIndex = 0; }
                @foreach (var mood in Enum.GetValues<MoodType>())
                {
                    var idx = moodIndex++;
                    <button class="mood-btn @(_selectedMood == mood ? "selected" : "")"
                            style="animation-delay: @(idx * 0.04)s"
                            @onclick="() => _selectedMood = mood">
                        <span class="mood-emoji">@MoodEmoji(mood)</span>
                        <span class="mood-label">@MoodLabel(mood)</span>
                    </button>
                }
            </div>

            <div class="note-section">
                <label>@T("ShareMoreLabel")</label>
                <textarea @bind="_additionalNote"
                          placeholder="@T("ShareMorePlaceholder")"
                          rows="2"></textarea>
            </div>

            <button class="bloom-btn primary" @onclick="GeneratePlanAsync"
                    disabled="@(_selectedMood == null || _generating)">
                @if (_generating)
                { <span>@T("CreatingPlan")</span> }
                else
                { <span>@T("CreateMyDayBtn")</span> }
            </button>

            @if (_error != null)
            {
                <div class="meal-gentle-note error-note">
                    <p>💗 @_error</p>
                    <button class="bloom-btn secondary small-btn" @onclick="GeneratePlanAsync">@T("TryAgain")</button>
                </div>
            }
        </div>
    }
    else if (_plan != null)
    {
        <div class="daily-plan">
            <div class="plan-header">
                <span class="week-badge">@string.Format(T("WeekBadge"), _profile?.CurrentWeek)</span>
                <h2>@string.Format(T("GentlePlanTitle"), MoodEmoji(_selectedMood!.Value))</h2>
            </div>

            <div class="plan-card acknowledgment">
                <p>@_plan.Acknowledgment</p>
            </div>

            <div class="plan-section">
                <h3>💧 @T("ForYouToday")</h3>
                <ul class="suggestion-list">
                    @foreach (var s in _plan.Suggestions)
                    {
                        <li>@s</li>
                    }
                </ul>
            </div>

            <div class="plan-card calming">
                <h3>🎵 @T("MomentOfCalm")</h3>
                <p>@_plan.CalmingRecommendation</p>
            </div>

            <div class="plan-card week-note">
                <h3>@string.Format(T("WeekHeading"), _profile?.CurrentWeek)</h3>
                <p>@_plan.WeekNote</p>
            </div>

            <div class="plan-card affirmation">
                <p class="affirmation-text">❤️ @_plan.Affirmation</p>
            </div>

            <RecommendedReading Topic="@(_profile?.CurrentWeek >= 34 ? "labor-delivery" : "pregnancy-general")" />

            <button class="bloom-btn secondary checkin-again-btn" @onclick="Reset">
                @T("CheckInAgain")
            </button>
        </div>
    }
</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private UserProfile? _profile;
    private bool _isAuthenticated;
    private MoodType? _selectedMood;
    private string? _additionalNote;
    private DailyPlan? _plan;
    private bool _generating;
    private bool _planGenerated;
    private string? _error;
    private CancellationTokenSource? _cts;
    private string _language = "English";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }

        if (_isAuthenticated)
        {
            _profile = await ProfileCache.GetAsync();
            _language = (_profile?.Language ?? AppLanguage.English).ToString();
        }
    }

    private async Task GeneratePlanAsync()
    {
        if (_selectedMood == null || _profile == null) return;
        _generating = true;
        _error = null;
        StateHasChanged();

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            var ctx = new AgentContext(_profile.Name, _profile.CurrentWeek, _profile.Language, _profile.WorkingWomanMode);
            _plan = await Agents.DayNurture.GenerateDailyPlanAsync(
                _selectedMood.Value,
                ctx,
                _additionalNote,
                _cts.Token);

            // Persist the check-in
            Db.MoodCheckIns.Add(new MoodCheckIn
            {
                UserId = await CurrentUser.GetUserIdAsync(),
                Mood = _selectedMood.Value,
                AdditionalNote = _additionalNote,
                GeneratedPlan = _plan.Acknowledgment
            });
            await Db.SaveChangesAsync();

            _planGenerated = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _error = T("GenericRetryError");
        }

        _generating = false;
    }

    private void Reset()
    {
        _selectedMood = null;
        _additionalNote = null;
        _plan = null;
        _planGenerated = false;
        _error = null;
    }

    public void Dispose() => _cts?.Cancel();

    private static string MoodEmoji(MoodType mood) => mood switch
    {
        MoodType.Exhausted   => "😴",
        MoodType.Anxious     => "😟",
        MoodType.Nauseous    => "🤢",
        MoodType.Emotional   => "🥺",
        MoodType.Happy       => "😊",
        MoodType.Energetic   => "✨",
        MoodType.Overwhelmed => "😮‍💨",
        MoodType.Peaceful    => "🌿",
        _                    => "💗"
    };

    private string MoodLabel(MoodType mood) => mood switch
    {
        MoodType.Exhausted   => T("MoodExhausted"),
        MoodType.Anxious     => T("MoodAnxious"),
        MoodType.Nauseous    => T("MoodNauseous"),
        MoodType.Emotional   => T("MoodEmotional"),
        MoodType.Happy       => T("MoodHappy"),
        MoodType.Energetic   => T("MoodEnergetic"),
        MoodType.Overwhelmed => T("MoodOverwhelmed"),
        MoodType.Peaceful    => T("MoodPeaceful"),
        _                    => mood.ToString()
    };

