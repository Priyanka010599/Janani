@page "/profile"
@using Janani.Models
@using Janani.Data
@using Janani.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject UserProfileCache ProfileCache
@rendermode InteractiveServer

<PageTitle>Janani — Your Profile</PageTitle>

<div class="bloom-container">
    <div class="section-header">
        <h1><Icon Name="profile"/> @T("Title")</h1>
        <p class="subtitle">@T("Subtitle")</p>
    </div>

    @if (_error != null)
    {
        <div class="meal-gentle-note error-note"><p>💗 @_error</p></div>
    }

    @if (_profile != null && _user != null)
    {
        <div class="appointment-form">
            <div class="form-field">
                <label>@T("NameLabel")</label>
                <input @bind="_name" placeholder="@T("NamePlaceholder")" />
            </div>

            <div class="form-field">
                <label class="checkbox-field">
                    <input type="checkbox" @bind="_tracksPregnancy" />
                    @T("TracksPregnancyLabel")
                </label>
                <p class="sos-hint">@T("TracksPregnancyHint")</p>
            </div>

            <div class="form-field">
                <label class="checkbox-field">
                    <input type="checkbox" @bind="_caresForElder" />
                    @T("CaresForElderLabel")
                </label>
            </div>

            <div class="form-field">
                <label class="checkbox-field">
                    <input type="checkbox" @bind="_caresForInfant" />
                    @T("CaresForInfantLabel")
                </label>
                <p class="sos-hint">@T("CaresForInfantHint")</p>
            </div>

            @if (_tracksPregnancy)
            {
                <div class="form-field">
                    <label>@T("WeeksPregnantLabel")</label>
                    <input type="number" @bind="_weeksPregnant" min="0" max="42" />
                    <p class="sos-hint">@T("CurrentWeekPrefix")@_profile.CurrentWeek@T("CurrentWeekSuffix")</p>
                </div>

                <div class="form-field">
                    <label class="checkbox-field">
                        <input type="checkbox" @bind="_workingWomanMode" />
                        @T("WorkingWomanLabel")
                    </label>
                </div>
            }

            @* Delivery capture. Recovery Plan and Postpartum Check-In both refuse
               to render without a delivery date, and told the user to record it
               "on your profile" -- which had no such field, so postpartum care
               was unreachable through the UI. Shown regardless of pregnancy
               tracking: she fills it in the day it happens, and a mother who
               joined after delivering needs it too. *@
            <div class="form-field">
                <label>@T("DeliveryDateLabel")</label>
                <input type="date" @bind="_deliveryDate" />
                <p class="sos-hint">@T("DeliveryDateHint")</p>
            </div>

            @if (_deliveryDate is not null)
            {
                <div class="form-field">
                    <label>@T("DeliveryTypeLabel")</label>
                    <select @bind="_deliveryTypeValue">
                        <option value="">@T("NotSaidYet")</option>
                        @foreach (var dt in Enum.GetValues<DeliveryType>())
                        {
                            <option value="@dt">@Humanize(dt.ToString())</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>@T("FeedingMethodLabel")</label>
                    <select @bind="_feedingMethodValue">
                        <option value="">@T("NotSaidYet")</option>
                        @foreach (var fm in Enum.GetValues<MaternalFeedingMethod>())
                        {
                            <option value="@fm">@Humanize(fm.ToString())</option>
                        }
                    </select>
                </div>
            }

            <div class="form-field">
                <label>@T("LanguageLabel")</label>
                <select @bind="_language">
                    @foreach (var lang in Enum.GetValues<AppLanguage>())
                    {
                        <option value="@lang">@lang.DisplayName()</option>
                    }
                </select>
                <p class="sos-hint">@T("LanguageHint")</p>
            </div>

            <div class="form-field">
                <label>@T("UsernameLabel")</label>
                <input value="@_user.Username" disabled />
                <p class="sos-hint">@T("UsernameHint")</p>
            </div>

            <div class="form-field">
                <label>@T("EmailLabel")</label>
                <input value="@_user.Email" disabled />
                <p class="sos-hint">@T("EmailHint")</p>
            </div>

            <div class="form-actions">
                <button class="bloom-btn primary" @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(_name)">
                    @T("SaveChangesButton")
                </button>
                @if (_justSaved)
                {
                    <span class="sos-hint">✅ @T("Saved")</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private UserProfile? _profile;
    private User? _user;
    private string _name = string.Empty;
    private int _weeksPregnant;
    private bool _workingWomanMode;
    private bool _tracksPregnancy;
    private bool _caresForElder;
    private bool _caresForInfant;
    private DateOnly? _deliveryDate;
    // Enum selects are backed by strings, not nullable enums: an empty <option>
    // cannot round-trip to null through @bind on a nullable enum.
    private string _deliveryTypeValue = string.Empty;
    private string _feedingMethodValue = string.Empty;
    private AppLanguage _language;
    private string _uiLanguage = "English";
    private string? _error;
    private bool _justSaved;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        _profile = await Db.UserProfiles.FirstOrDefaultAsync(p => p.UserId == userId);
        _user = await Db.Users.FirstOrDefaultAsync(u => u.Id == userId);

        if (_profile != null)
        {
            _name = _profile.Name;
            _weeksPregnant = _profile.CurrentWeek;
            _workingWomanMode = _profile.WorkingWomanMode;
            _tracksPregnancy = _profile.TracksPregnancy;
            _caresForElder = _profile.CaresForElder;
            _caresForInfant = _profile.CaresForInfant;
            _deliveryDate = _profile.DeliveryDate;
            _deliveryTypeValue = _profile.DeliveryType?.ToString() ?? string.Empty;
            _feedingMethodValue = _profile.FeedingMethod?.ToString() ?? string.Empty;
            _language = _profile.Language;
            _uiLanguage = _profile.Language.ToString();
        }
    }

    private async Task SaveAsync()
    {
        if (_profile == null || string.IsNullOrWhiteSpace(_name)) return;
        _error = null;
        _justSaved = false;

        try
        {
            _profile.Name = _name.Trim();
            _profile.TracksPregnancy = _tracksPregnancy;
            _profile.CaresForElder = _caresForElder;
            _profile.CaresForInfant = _caresForInfant;
            _profile.Language = _language;
            _profile.DeliveryDate = _deliveryDate;
            _profile.DeliveryType = Enum.TryParse<DeliveryType>(_deliveryTypeValue, out var deliveryType)
                ? deliveryType : null;
            _profile.FeedingMethod = Enum.TryParse<MaternalFeedingMethod>(_feedingMethodValue, out var feeding)
                ? feeding : null;
            if (_tracksPregnancy)
            {
                _profile.PregnancyStartDate = DateOnly.FromDateTime(DateTime.Today).AddDays(-(Math.Clamp(_weeksPregnant, 0, 42) * 7));
                _profile.WorkingWomanMode = _workingWomanMode;
            }
            await Db.SaveChangesAsync();

            // NavMenu (and any other layout-level state) only reads the
            // profile once when its component is first created in this
            // circuit -- Invalidate() now raises UserProfileCache.Changed,
            // which NavMenu subscribes to so it re-reads and re-renders
            // itself instead of needing a full page reload here.
            ProfileCache.Invalidate();
            _justSaved = true;
        }
        catch (Exception)
        {
            _error = T("SaveError");
        }
    }

    // "VaginalWithTearOrEpisiotomy" -> "Vaginal with tear or episiotomy".
    // These are clinical terms and stay English in every UI language, same as
    // the medicine names elsewhere; translating them is a separate decision.
    private static string Humanize(string enumName)
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < enumName.Length; i++)
        {
            if (i > 0 && char.IsUpper(enumName[i]))
            {
                sb.Append(' ');
                sb.Append(char.ToLowerInvariant(enumName[i]));
            }
            else sb.Append(enumName[i]);
        }
        return sb.ToString();
    }

